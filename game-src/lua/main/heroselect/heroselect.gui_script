local defsave 		= require('defsave/defsave')
local actions 		= require('actions')
local loc 			= require("shared.locsheets")

local currentPage = "heroselect"
local controller	= "main:/menu#controller"
local DUNGEON		= "main:/menu#dungeonmine"

--[[ The hero roster. Tapping a hero slot on a dungeon's map swaps its level
list for this: a card for every field hero, under the map so the slots stay in
sight. A card is tapped for the hero's details, or held and dragged onto a
slot; a slot's hero is dragged back onto the cards to stand it down, or onto
another slot to trade places. A hero working somewhere else asks first, since
its old slot is left empty.

The dungeon screen is at the engine's node limit with its level list, so the
roster is drawn here, over it, and the dungeon screen sends where its slots
are and who is in them (roster_update). Everything here is laid out in the
same space as that screen's content: design units, origin at the bottom left
of the screen. The shipped hero select list in this scene is never shown. ]]

local DESIGN_W = 750
local DESIGN_H = 1334
local HEADER_DEPTH = 255.5	-- underside of the header's top bar, from the top edge
local EVENT_BAR_H = 52		-- the header's event bar, on event maps only
local FOOTER_TOP = 105		-- top of the header's bottom bar, from the bottom edge
local LIST_BOTTOM = 80		-- the dungeon list runs a little under the bottom bar

local HP_HEADER_H = 84		-- title strip over the cards
local HP_PAD = 16
local HP_CARD_W = 220		-- widest a card grows before another column fits
local HP_HOLD = 0.2			-- seconds a still press takes to pick a card up
local HP_SLOP = 14			-- how far a press may wander and still be a tap

local VIRTUE_COLOUR = {
	Wrath = vmath.vector4(0.86, 0.2, 0.24, 1),
	Greed = vmath.vector4(0.38, 0.76, 0.3, 1),
	Zeal = vmath.vector4(0.98, 0.78, 0.25, 1),
	Stasis = vmath.vector4(0.62, 0.56, 0.72, 1),
	Reason = vmath.vector4(0.32, 0.56, 0.96, 1),
	Empathy = vmath.vector4(0.98, 0.56, 0.76, 1),
}
-- The panel art in each virtue's colour; Empathy has none, so grey tinted pink.
local VIRTUE_PANEL = { Wrath = "red", Greed = "green", Zeal = "gold", Stasis = "purple", Reason = "blue", Empathy = "grey" }

local WHITE = vmath.vector4(1, 1, 1, 1)
local SOFT = vmath.vector4(0.85, 0.82, 0.78, 1)
local HERE = vmath.vector4(1, 0.84, 0.3, 1)
local FREE = vmath.vector4(0.5, 0.9, 0.35, 1)
local AWAY = vmath.vector4(1, 0.62, 0.3, 1)

local hp = { open = false, cards = {}, scroll = 0, slots = {} }
local view = { w = DESIGN_W, h = DESIGN_H, list_top = 600 }
local map_id, dungeon_id = 1, 1

--[[******************************************
					SCREEN FIT
********************************************]]

-- The root goes on a plain uniform fit, as on every other screen; hp.base
-- then sits on the screen's bottom left corner.
local function fit_scale()
	local ww, wh = window.get_size()
	return math.min(ww / DESIGN_W, wh / DESIGN_H)
end

local function place_base()
	local root = gui.get_node("root")
	gui.set_adjust_mode(root, gui.ADJUST_FIT)
	gui.set_xanchor(root, gui.ANCHOR_NONE)
	gui.set_yanchor(root, gui.ANCHOR_NONE)
	gui.set_position(hp.base, vmath.vector3((DESIGN_W - view.w) / 2, (DESIGN_H - view.h) / 2, 0))
end

-- A press, in hp.base space.
local function touch_at(action)
	local s = fit_scale()
	return vmath.vector3(action.screen_x / s, action.screen_y / s, 0)
end

-- Wall-clock seconds. The engine's dt is a fixed step per frame, so on a
-- slow frame it undercounts a held press.
local function now()
	return socket and socket.gettime() or os.clock()
end

local function in_rect(r, p)
	return r and math.abs(p.x - r.x) <= r.w / 2 and math.abs(p.y - r.y) <= r.h / 2
end

--[[******************************************
					BUILDING
********************************************]]

local function new_node(parent, pos, size, texture, flipbook)
	local node = gui.new_box_node(pos, size)
	gui.set_parent(node, parent)
	if texture then
		gui.set_texture(node, texture)
		gui.play_flipbook(node, flipbook)
		gui.set_size_mode(node, gui.SIZE_MODE_MANUAL)
		gui.set_size(node, size)
	end
	return node
end

local function new_panel(parent, pos, size, flipbook)
	local node = new_node(parent, pos, size, "main", flipbook)
	gui.set_slice9(node, vmath.vector4(32, 32, 32, 32))
	return node
end

local function new_text(parent, font, pos, text, color)
	local node = gui.new_text_node(pos, text or "")
	gui.set_font(node, font)
	gui.set_parent(node, parent)
	gui.set_color(node, color or WHITE)
	gui.set_outline(node, vmath.vector4(0, 0, 0, 1))
	return node
end

-- Scales a line of text to a height, then down again if it runs too wide.
local function fit_text(node, max_w, max_h)
	local m = gui.get_text_metrics_from_node(node)
	if m.width <= 0 or m.height <= 0 then return end
	local s = math.min(max_h / m.height, max_w / m.width)
	gui.set_scale(node, vmath.vector3(s, s, 1))
end

-- Wraps text to a width at the scale that gives one line `line_h`.
local function wrap_text(node, max_w, line_h)
	local m = gui.get_text_metrics_from_node(node)
	if m.height <= 0 then return 0 end
	local s = line_h / m.height
	gui.set_scale(node, vmath.vector3(s, s, 1))
	gui.set_size(node, vmath.vector3(max_w / s, 0, 0))
	gui.set_line_break(node, true)
	return gui.get_text_metrics_from_node(node).height * s
end

-- A window onto a hero's portrait, cropped to cover it.
local function new_portrait(parent, pos, size, hero)
	local window = new_node(parent, pos, size)
	gui.set_clipping_mode(window, gui.CLIPPING_MODE_STENCIL)
	gui.set_clipping_visible(window, false)
	local art = new_node(window, vmath.vector3(0, 0, 0), size, hero.Portrait.texture, hero.Portrait.flipbook)
	gui.set_inherit_alpha(art, true)
	actions.fill_card_window(art, window)
	return window
end

local function virtue(hero, n)
	local v = hero.Virtues and hero.Virtues[n]
	return v and v.Virtue
end

-- A hero's panel, in the colour of its first virtue.
local function hero_panel(parent, pos, size, hero)
	local first = virtue(hero, 1)
	local node = new_panel(parent, pos, size, "tinyfancypanel_" .. (VIRTUE_PANEL[first] or "darkgrey"))
	if first == "Empathy" then gui.set_color(node, VIRTUE_COLOUR.Empathy) end
	return node
end

local function power_icon(hero)
	local power = hero.Powers and hero.Powers[1]
	if not power or not power.Stages then return nil end
	return power.Stages[#power.Stages].Icon
end

local function place_name(location)
	local map = defsave.get("Map", location.map_id)
	local dungeon = map and map[location.dungeon_id]
	return dungeon and loc.get(dungeon.Name) or ""
end

-- Where a hero is, seen from this dungeon: "here", "free" or "away".
local function where(hero)
	local at = hero.location
	if at == nil or at.map_id == nil or at.dungeon_id == nil then return "free" end
	if at.map_id == map_id and at.dungeon_id == dungeon_id then return "here" end
	return "away"
end

local function tag(hero)
	local w = where(hero)
	if w == "here" then return loc.get("HERO_TAG_HERE"), HERE end
	if w == "free" then return loc.get("HERO_TAG_FREE"), FREE end
	return (string.gsub(loc.get("HERO_TAG_AT"), "%%1", place_name(hero.location))), AWAY
end

-- Every field hero the player has: free ones first, then the ones working
-- elsewhere, then the ones already here.
local WHERE_ORDER = { free = 1, away = 2, here = 3 }
local function roster()
	local rows = {}
	for h,hero in ipairs(defsave.loaded.Hero.data) do
		if not hero.Locked and not actions.is_patron(hero) and hero.Portrait then
			table.insert(rows, { id = h, hero = hero, where = where(hero) })
		end
	end
	table.sort(rows, function(a, b)
		if a.where ~= b.where then return WHERE_ORDER[a.where] < WHERE_ORDER[b.where] end
		if (a.hero.Level or 0) ~= (b.hero.Level or 0) then return (a.hero.Level or 0) > (b.hero.Level or 0) end
		return a.id < b.id
	end)
	return rows
end

local function signature(rows)
	local parts = { map_id, dungeon_id }
	for _,row in ipairs(rows) do
		local at = row.hero.location or {}
		table.insert(parts, row.id .. ":" .. (row.hero.Level or 0) .. ":" .. tostring(at.map_id) .. ":" .. tostring(at.dungeon_id) .. ":" .. tostring(at.slot_id))
	end
	return table.concat(parts, "|")
end

local function build_card(row, x, y, w, h)
	local hero = row.hero
	local card = { id = row.id, where = row.where }
	card.bg = hero_panel(hp.content, vmath.vector3(x, y - h / 2, 0), vmath.vector3(w, h, 0), hero)

	local inset = 12
	local win = w - inset * 2
	local top = h / 2 - inset
	new_portrait(card.bg, vmath.vector3(0, top - win / 2, 0), vmath.vector3(win, win, 0), hero)
	-- The second virtue, as a band under the portrait.
	local band = new_node(card.bg, vmath.vector3(0, top - win - 4, 0), vmath.vector3(win, 8, 0))
	gui.set_color(band, VIRTUE_COLOUR[virtue(hero, 2)] or VIRTUE_COLOUR[virtue(hero, 1)] or SOFT)

	local icon = power_icon(hero)
	if icon then
		local size = math.floor(win * 0.3)
		new_node(card.bg, vmath.vector3(win / 2 - size / 2 + 4, top - win + size / 2 - 4, 0), vmath.vector3(size, size, 0), icon.texture, icon.flipbook)
	end

	local below = top - win - 12
	-- A dark backing so the level and tag read on every panel colour.
	local backing = new_node(card.bg, vmath.vector3(0, (below - 4 + (-h / 2 + inset)) / 2, 0), vmath.vector3(win, below - 4 + h / 2 - inset, 0))
	gui.set_color(backing, vmath.vector4(0, 0, 0, 0.45))
	fit_text(new_text(card.bg, "title", vmath.vector3(0, below - 20, 0), loc.get(hero.Name)), win, 36)
	fit_text(new_text(card.bg, "font", vmath.vector3(0, below - 52, 0), (loc.get("HERO_LEVEL", hero.Level or 0)), SOFT), win, 26)
	local tag_text, tag_colour = tag(hero)
	fit_text(new_text(card.bg, "font", vmath.vector3(0, below - 82, 0), tag_text, tag_colour), win, 24)

	-- A hero already here is still on the list, to drag to another slot, but
	-- dimmed so the free ones read first.
	if row.where == "here" then
		gui.set_color(card.bg, gui.get_color(card.bg) * 0.6 + vmath.vector4(0, 0, 0, 0.4))
	end
	card.color = gui.get_color(card.bg)
	return card
end

local function scroll_to(y)
	local max = math.max(0, (hp.content_h or 0) - hp.window_h)
	hp.scroll = math.max(0, math.min(max, y))
	if hp.content then gui.set_position(hp.content, vmath.vector3(0, hp.scroll, 0)) end
end

local function layout_cards()
	if hp.content then gui.delete_node(hp.content) end
	hp.cards = {}
	local w = view.w
	local rows = roster()
	hp.signature = signature(rows)

	hp.content = new_node(hp.window, vmath.vector3(0, hp.scroll, 0), vmath.vector3(0, 0, 0))
	local cols = math.max(3, math.floor((w - HP_PAD) / (HP_CARD_W + HP_PAD)))
	local card_w = (w - HP_PAD * (cols + 1)) / cols
	local card_h = card_w + 120
	for i,row in ipairs(rows) do
		local col, line = (i - 1) % cols, math.floor((i - 1) / cols)
		local x = HP_PAD + card_w / 2 + col * (card_w + HP_PAD)
		local y = -(HP_PAD + line * (card_h + HP_PAD))
		table.insert(hp.cards, build_card(row, x, y, card_w, card_h))
	end
	hp.content_h = HP_PAD + math.ceil(#rows / cols) * (card_h + HP_PAD)
	scroll_to(hp.scroll)
end

local function build()
	if hp.panel then gui.delete_node(hp.panel) end
	place_base()
	local w, top = view.w, view.list_top
	hp.panel = new_node(hp.base, vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))

	-- The level list's dark backdrop stays under the cards; this covers the
	-- strip of it the title takes.
	local header = new_panel(hp.panel, vmath.vector3(w / 2, top - HP_HEADER_H / 2, 0), vmath.vector3(w, HP_HEADER_H, 0), "tinyfancypanel_darkbrown")
	local title = new_text(header, "title", vmath.vector3(-w / 2 + 24, 12, 0), loc.get("HEROES_PANEL_TITLE"))
	gui.set_pivot(title, gui.PIVOT_W)
	fit_text(title, w * 0.5, 38)
	local hint = new_text(header, "font", vmath.vector3(-w / 2 + 24, -20, 0), loc.get("HEROES_PANEL_HINT"), SOFT)
	gui.set_pivot(hint, gui.PIVOT_W)
	fit_text(hint, w - 260, 24)
	hp.done = new_panel(header, vmath.vector3(w / 2 - 24 - 90, 0, 0), vmath.vector3(180, 60, 0), "tinyfancypanel_green")
	fit_text(new_text(hp.done, "title", vmath.vector3(0, 2, 0), string.upper(loc.get("HEROES_DONE"))), 150, 30)

	hp.window_h = top - HP_HEADER_H - LIST_BOTTOM
	hp.window = new_node(hp.panel, vmath.vector3(0, top - HP_HEADER_H, 0), vmath.vector3(w, hp.window_h, 0))
	gui.set_pivot(hp.window, gui.PIVOT_NW)
	gui.set_clipping_mode(hp.window, gui.CLIPPING_MODE_STENCIL)
	gui.set_clipping_visible(hp.window, false)
	hp.built = view.w .. "|" .. view.h .. "|" .. view.list_top
	layout_cards()
end

--[[******************************************
					HERO DETAILS
********************************************]]

local function hero_in_slot(slot)
	local s = hp.slots[slot]
	return s and s.hero > 0 and s.hero or nil
end

local function first_empty_slot()
	for s,slot in ipairs(hp.slots) do
		if slot.hero == 0 then return s end
	end
end

local function close_popup()
	if hp.popup then gui.delete_node(hp.popup.root) end
	hp.popup = nil
	msg.post("main:/overlay#header", "set_active", { active = true })
end

-- Puts a hero in a slot, asking first when that leaves a slot elsewhere.
local function place(id, slot)
	local hero = defsave.loaded.Hero.data[id]
	local message = { hero_id = id, map_id = map_id, dungeon_id = dungeon_id, slot_id = slot }
	hp.landing = id
	if where(hero) == "away" then
		local name = loc.get(hero.Name)
		local text = string.gsub(loc.get("HERO_MOVE_TEXT"), "%%1", name)
		text = string.gsub(text, "%%2", place_name(hero.location))
		msg.post(controller, "popup_confirm", {
			title = (string.gsub(loc.get("HERO_MOVE_TITLE"), "%%1", name)), text = text,
			msgpost = { message_id = "assign_hero", message = message } })
	else
		msg.post(controller, "assign_hero", message)
	end
end

local function open_popup(id)
	close_popup()
	local hero = defsave.loaded.Hero.data[id]
	if not hero then return end
	local w, h = view.w, view.h
	local popup = { id = id, where = where(hero) }
	popup.root = new_node(hp.base, vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	local dim = new_node(popup.root, vmath.vector3(w / 2, h / 2, 0), vmath.vector3(w, h, 0))
	gui.set_color(dim, vmath.vector4(0, 0, 0, 0.7))

	local pw = math.min(w - 48, 620)
	local content_top = h - HEADER_DEPTH - (view.event and EVENT_BAR_H or 0)
	local ph = math.min(content_top - FOOTER_TOP - 24, 900)
	popup.panel = hero_panel(popup.root, vmath.vector3(w / 2, (content_top + FOOTER_TOP) / 2, 0), vmath.vector3(pw, ph, 0), hero)
	local inner = new_panel(popup.panel, vmath.vector3(0, 0, 0), vmath.vector3(pw - 24, ph - 24, 0), "tinyfancypanel_charcoal")
	local iw = pw - 56
	local y = ph / 2 - 28

	local art_h = math.min(iw * 0.62, ph * 0.38)
	new_portrait(inner, vmath.vector3(0, y - art_h / 2, 0), vmath.vector3(iw, art_h, 0), hero)
	y = y - art_h
	local band = new_node(inner, vmath.vector3(0, y - 5, 0), vmath.vector3(iw, 10, 0))
	gui.set_color(band, VIRTUE_COLOUR[virtue(hero, 2)] or VIRTUE_COLOUR[virtue(hero, 1)] or SOFT)
	y = y - 10

	fit_text(new_text(inner, "title", vmath.vector3(0, y - 34, 0), loc.get(hero.Name)), iw, 52)
	local level = loc.get("HERO_LEVEL", hero.Level or 0) .. "  -  " .. loc.get("RARITY_" .. string.upper(hero.Rarity or ""))
	fit_text(new_text(inner, "font", vmath.vector3(0, y - 78, 0), level, SOFT), iw, 28)
	y = y - 104

	-- Virtue chips, in the hero's colour order.
	local chips = hero.Virtues or {}
	local chip_w = math.min(170, (iw - 16 * (#chips - 1)) / math.max(1, #chips))
	local row_w = #chips * chip_w + (#chips - 1) * 16
	for v,chip in ipairs(chips) do
		local cx = -row_w / 2 + chip_w / 2 + (v - 1) * (chip_w + 16)
		local node = new_node(inner, vmath.vector3(cx, y - 22, 0), vmath.vector3(chip_w, 40, 0))
		gui.set_color(node, VIRTUE_COLOUR[chip.Virtue] or SOFT)
		fit_text(new_text(node, "font", vmath.vector3(0, 0, 0), loc.get("VIRTUE_" .. string.upper(chip.Virtue))), chip_w - 16, 24)
	end
	y = y - 64

	-- The power: what it is and what it does.
	local power = hero.Powers and hero.Powers[1]
	local icon = power_icon(hero)
	if power and icon then
		local size = 96
		new_node(inner, vmath.vector3(-iw / 2 + size / 2, y - size / 2, 0), vmath.vector3(size, size, 0), icon.texture, icon.flipbook)
		local tx = -iw / 2 + size + 20
		local name = new_text(inner, "title", vmath.vector3(tx, y - 18, 0), loc.get(power.Name), HERE)
		gui.set_pivot(name, gui.PIVOT_W)
		fit_text(name, iw - size - 20, 34)
		local desc = new_text(inner, "font", vmath.vector3(tx, y - 40, 0), loc.get((string.gsub(power.Name, "_NAME$", "_DESC"))))
		gui.set_pivot(desc, gui.PIVOT_NW)
		local desc_h = wrap_text(desc, iw - size - 20, 26)
		y = y - math.max(size, 40 + desc_h) - 20
	end

	local where_text, where_colour = tag(hero)
	fit_text(new_text(inner, "font", vmath.vector3(0, y - 18, 0), where_text, where_colour), iw, 28)

	-- Along the bottom: the one thing to do with this hero, and close.
	local by = -(ph - 24) / 2 + 56
	local bw = (iw - 20) / 2
	local action_text, action_flipbook
	if popup.where == "here" then
		action_text, action_flipbook = loc.get("HERO_REMOVE"), "tinyfancypanel_red"
	elseif first_empty_slot() then
		action_text, action_flipbook = loc.get("HERO_ASSIGN"), "tinyfancypanel_green"
		popup.slot = first_empty_slot()
	else
		action_text, action_flipbook = loc.get("HERO_SLOTS_FULL"), "tinyfancypanel_darkgrey"
	end
	popup.action = new_panel(inner, vmath.vector3(-bw / 2 - 10, by, 0), vmath.vector3(bw, 76, 0), action_flipbook)
	fit_text(new_text(popup.action, "title", vmath.vector3(0, 2, 0), string.upper(action_text)), bw - 24, 32)
	popup.close = new_panel(inner, vmath.vector3(bw / 2 + 10, by, 0), vmath.vector3(bw, 76, 0), "tinyfancypanel_darkgrey")
	fit_text(new_text(popup.close, "title", vmath.vector3(0, 2, 0), string.upper(loc.get("HERO_CLOSE"))), bw - 24, 32)

	gui.set_scale(popup.panel, vmath.vector3(0.92, 0.92, 1))
	gui.animate(popup.panel, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.25)
	hp.popup = popup
	msg.post("main:/overlay#header", "set_active", { active = false })
end

local function popup_input(action)
	if not action.released then return end
	local popup = hp.popup
	if gui.pick_node(popup.action, action.x, action.y) then
		if popup.where == "here" then
			msg.post(controller, "unassign_hero", { hero_id = popup.id })
			close_popup()
		elseif popup.slot then
			local id, slot = popup.id, popup.slot
			close_popup()
			place(id, slot)
		end
	elseif gui.pick_node(popup.close, action.x, action.y) or not gui.pick_node(popup.panel, action.x, action.y) then
		close_popup()
	end
end

--[[******************************************
					DRAGGING
********************************************]]

local function slot_at(p)
	for s,slot in ipairs(hp.slots) do
		if in_rect(slot.panel, p) then return s end
	end
end

local function clear_targets()
	for _,node in pairs(hp.targets or {}) do gui.delete_node(node) end
	hp.targets = nil
end

-- Lights every slot a hero can be dropped on.
local function show_targets()
	clear_targets()
	hp.targets = {}
	for s,slot in ipairs(hp.slots) do
		local r = slot.panel
		local glow = new_node(hp.base, vmath.vector3(r.x, r.y, 0), vmath.vector3(r.w + 20, r.h + 20, 0))
		gui.set_color(glow, vmath.vector4(1, 0.84, 0.3, 0.15))
		gui.animate(glow, "color.w", 0.4, gui.EASING_INOUTSINE, 0.6, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
		hp.targets[s] = glow
	end
end

local function fade_slot(slot, alpha)
	msg.post(DUNGEON, "roster_fade", { slot = slot, alpha = alpha })
end

local function lift(press)
	press.lifted = true
	local hero = defsave.loaded.Hero.data[press.id]
	local size = 150
	press.ghost = hero_panel(hp.base, press.now, vmath.vector3(size, size + 20, 0), hero)
	new_portrait(press.ghost, vmath.vector3(0, 0, 0), vmath.vector3(size - 20, size, 0), hero)
	gui.set_scale(press.ghost, vmath.vector3(0.8, 0.8, 1))
	gui.animate(press.ghost, "scale", vmath.vector3(1.1, 1.1, 1), gui.EASING_OUTBACK, 0.18)
	if press.card then
		local c = press.card.color
		gui.set_color(press.card.bg, vmath.vector4(c.x, c.y, c.z, 0.35))
	end
	if press.slot then fade_slot(press.slot, 0.35) end
	show_targets()
end

local function drop(press)
	local slot = slot_at(press.now)
	local placed = false
	if press.slot then
		fade_slot(press.slot, 1)
		if slot and slot ~= press.slot then
			hp.landing = press.id
			msg.post(controller, "assign_hero", { hero_id = press.id, map_id = map_id, dungeon_id = dungeon_id, slot_id = slot })
			placed = true
		elseif not slot and gui.pick_node(hp.window, press.x, press.y) then
			msg.post(controller, "unassign_hero", { hero_id = press.id })
			placed = true
		end
	elseif slot and hero_in_slot(slot) ~= press.id then
		place(press.id, slot)
		placed = true
	end
	clear_targets()
	local delete = function(self, node) gui.delete_node(node) end
	if placed then
		gui.animate(press.ghost, "scale", vmath.vector3(0.2, 0.2, 1), gui.EASING_INBACK, 0.15, 0, delete)
	else
		-- Nowhere to go: back where it came from.
		gui.animate(press.ghost, "position", press.home, gui.EASING_OUTQUAD, 0.2, 0, delete)
		if press.card then gui.set_color(press.card.bg, press.card.color) end
	end
end

local function card_at(x, y)
	if not gui.pick_node(hp.window, x, y) then return nil end
	for _,card in ipairs(hp.cards) do
		if gui.pick_node(card.bg, x, y) then return card end
	end
end

-- The card's centre in hp.base space, to send a ghost back to.
local function card_home(card)
	local p = gui.get_position(card.bg)
	return vmath.vector3(p.x, p.y + hp.scroll + view.list_top - HP_HEADER_H, 0)
end

local function close()
	if not hp.open then return end
	hp.open = false
	hp.press = nil
	close_popup()
	clear_targets()
	if hp.panel then gui.delete_node(hp.panel) end
	hp.panel, hp.content, hp.cards, hp.signature, hp.built = nil, nil, {}, nil, nil
end

local function roster_input(action_id, action)
	if hp.popup then
		if action_id == hash("touch") then popup_input(action) end
		return true
	end
	if action_id == hash("scroll_up") or action_id == hash("scroll_down") then
		if gui.pick_node(hp.window, action.x, action.y) then
			scroll_to(hp.scroll + (action_id == hash("scroll_up") and -80 or 80))
			return true
		end
		return false
	end
	if action_id ~= hash("touch") then return false end

	local p = touch_at(action)
	local press = hp.press
	if action.pressed then
		if gui.pick_node(hp.done, action.x, action.y) then
			hp.press = { done = true, at = p, now = p }
			return true
		end
		local start = { at = p, now = p, x = action.x, y = action.y, t = now(), scroll = hp.scroll }
		local card = card_at(action.x, action.y)
		if card then
			start.card, start.id = card, card.id
			start.home = card_home(card)
		else
			local slot = slot_at(p)
			local id = slot and hero_in_slot(slot)
			if id then
				if in_rect(hp.slots[slot].unassign, p) then
					msg.post(controller, "unassign_hero", { hero_id = id })
					return true
				end
				start.slot, start.id = slot, id
				local r = hp.slots[slot].panel
				start.home = vmath.vector3(r.x, r.y, 0)
			elseif not gui.pick_node(hp.window, action.x, action.y) then
				return false
			end
		end
		hp.press = start
		return true
	end
	if not press then return false end

	press.now, press.x, press.y = p, action.x, action.y
	local moved = vmath.length(p - press.at)
	if action.released then
		hp.press = nil
		if press.done then
			if gui.pick_node(hp.done, action.x, action.y) then
				close()
				msg.post(DUNGEON, "roster_closed")
			end
		elseif press.lifted then
			drop(press)
		elseif press.id and not press.scrolling and moved <= HP_SLOP then
			open_popup(press.id)
		end
		return true
	end

	if press.lifted then
		gui.set_position(press.ghost, p)
		local over = slot_at(p)
		for s,glow in pairs(hp.targets or {}) do
			gui.set_scale(glow, vmath.vector3(1, 1, 1) * (s == over and 1.08 or 1))
		end
	elseif press.scrolling then
		scroll_to(press.scroll + (p.y - press.at.y))
	elseif moved > HP_SLOP and not press.done then
		local d = p - press.at
		-- A slot's hero, or a card pushed sideways, comes up at once; a quick
		-- push up or down the list scrolls it.
		if press.slot or (press.card and math.abs(d.x) > math.abs(d.y)) then
			lift(press)
		else
			press.scrolling = true
			scroll_to(press.scroll + d.y)
		end
	end
	return true
end

--[[******************************************
					LIFECYCLE
********************************************]]

function init(self)
	print(string.upper(currentPage), "init")
	-- The shipped list in this scene is never shown.
	for _,id in ipairs({ "heroselect/root", "panel_bottom/bg" }) do gui.set_enabled(gui.get_node(id), false) end
	hp.base = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_parent(hp.base, gui.get_node("root"))
	gui.set_render_order(5)
end

function update(self, dt)
	if not hp.open then return end
	if hp.built ~= view.w .. "|" .. view.h .. "|" .. view.list_top then build() end
	-- Cards follow the heroes: a move, a level up or another dungeon. Held
	-- back while the details are up, which would otherwise draw under them.
	if not hp.popup and not hp.press and signature(roster()) ~= hp.signature then
		layout_cards()
	end
	if hp.landing then
		local at = defsave.loaded.Hero.data[hp.landing].location
		if at and at.map_id == map_id and at.dungeon_id == dungeon_id and hero_in_slot(at.slot_id) == hp.landing then
			msg.post(DUNGEON, "roster_punch", { slot = at.slot_id })
			hp.landing = nil
		end
	end
	-- A card held still long enough comes up off the list.
	local press = hp.press
	if press and press.card and not press.lifted and not press.scrolling then
		if now() - press.t >= HP_HOLD then lift(press) end
	end
end

function on_input(self, action_id, action)
	if hp.open and action_id ~= nil then
		return roster_input(action_id, action)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("roster_update") then
		map_id, dungeon_id = message.map_id, message.dungeon_id
		view.w, view.h, view.list_top, view.event = message.w, message.h, message.list_top, message.event
		hp.slots = message.slots or {}
		-- Another dungeon's slots: a drop or a punch meant for the last one is off.
		if hp.landing and not defsave.loaded.Hero.data[hp.landing] then hp.landing = nil end
	elseif message_id == hash("roster_open") then
		hp.open, hp.scroll, hp.built = true, 0, nil
	elseif message_id == hash("roster_close") then
		close()
	end
end
