local gooey 		= require('gooey.gooey')
local inspect 		= require('inspect')
local defsave 		= require('defsave/defsave')
local loc 			= require("shared.locsheets")

local productName = "OoR"
local currentPage = "rankUp_popup"
local controller = "main:/menu#controller"
local enabled = false
local pause = true
local amount = 0
local spring = 1
local base = 0
local tock = nil

local color = {
	Common = "fancybutton_darkgrey",
	Wild = "fancybutton_brown",
	Rare = "fancybutton_green",
	Epic = "fancybutton_blue",
	Legendary = "fancybutton_purple",
	Exotic = "fancybutton_orange"
}

--[[******************************************
					SCREEN FIT
********************************************]]

--[[ The scene is drawn for a 750x1334 phone and Defold fits that rectangle
into the window, so on any other shape the room left over turns into margin
and anything full bleed stops reaching the edges. The root goes on a plain
uniform fit, and the parts that have to touch an edge are placed against the
real one. The long version of this note is in main/nav/header.gui_script. ]]
local DESIGN_W = 750
local DESIGN_H = 1334
local HEADER_DEPTH = 255.5	-- underside of the header's top bar, from the top edge
local FOOTER_TOP = 105		-- top of the header's bottom bar, from the bottom edge

local screen = { w = 0, h = 0 }

-- The screen in design units, or nil if it has not changed since last call.
local function screen_changed()
	local ww, wh = window.get_size()
	local scale = math.min(ww / DESIGN_W, wh / DESIGN_H)
	local w, h = ww / scale, wh / scale
	if math.abs(w - screen.w) < 1 and math.abs(h - screen.h) < 1 then return nil end
	screen.w, screen.h = w, h
	local root = gui.get_node("root")
	gui.set_adjust_mode(root, gui.ADJUST_FIT)
	gui.set_xanchor(root, gui.ANCHOR_NONE)
	gui.set_yanchor(root, gui.ANCHOR_NONE)
	return w, h
end

local function screen_left()	return (DESIGN_W - screen.w) / 2 end
local function screen_bottom()	return (DESIGN_H - screen.h) / 2 end
local function screen_top()		return screen_bottom() + screen.h end
local function content_top()	return screen_top() - HEADER_DEPTH end
local function content_bottom()	return screen_bottom() + FOOTER_TOP end

local function place(id, x, y)
	local node = gui.get_node(id)
	local p = gui.get_position(node)
	gui.set_position(node, vmath.vector3(x or p.x, y or p.y, p.z))
	return node
end

local function resize(id, w, h)
	local node = gui.get_node(id)
	local s = gui.get_size(node)
	gui.set_size(node, vmath.vector3(w or s.x, h or s.y, s.z))
	return node
end

local function layout_screen()
	local w, h = screen_changed()
	if not w then return end
	place("root/center", nil, screen_bottom() + h / 2)
end

function init(self)
	layout_screen()
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)
	gui.set_render_order(15)
	gooey.acquire_input()
	local nameNode = gui.get_node("card/name")
	local descNode = gui.get_node("card/text")
end

local function unpause()
	pause = false
end

local function animate_card()
	local node = gui.get_node("upgradecard/bg")
	gui.set_scale(node, vmath.vector3(0.9, 0.9, 0.9))
	gui.animate(node, gui.PROP_SCALE, vmath.vector3(1, 1, 1), go.EASING_OUTELASTIC, 0.75, 0, unpause)
end

--[[ Tock, the patron for time (gdd/heroes-roster.md), winds its key and the
warp stretches: the card shows the warp bought, then the warp Tock made of
it. ]]
local function show_tock()
	if not tock then
		tock = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(200, 200, 0))
		gui.set_texture(tock, "main")
		gui.play_flipbook(tock, "patron_tock")
		gui.set_parent(tock, gui.get_node("upgradecard/bg"))
	end
	local card = gui.get_size(gui.get_node("upgradecard/bg"))
	gui.set_enabled(tock, true)
	gui.set_position(tock, vmath.vector3(card.x / 2 + 140, card.y * 0.3, 0))
	gui.animate(tock, "position.x", card.x / 2 - 30, gui.EASING_OUTBACK, 0.4, 0.6, function()
		gui.animate(tock, "rotation.z", -12, gui.EASING_INOUTSINE, 0.15, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
		local name = gui.get_node("card/name")
		gui.set_text(name, string.upper(loc.get("TIMEWARP_NAME", math.floor(amount * 10 + 0.5) / 10)) .. "\n" .. loc.get("HERO_BONUS_WOUNDSPRING", { math.floor((spring - 1) * 100 + 0.5) .. "%" }))
		gui.animate(name, "scale", gui.get_scale(name) * 1.15, gui.EASING_OUTQUAD, 0.12, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
	end)
end

local function update_card()
	gui.set_text(gui.get_node("card/name"), string.upper(loc.get("TIMEWARP_NAME", spring > 1 and base or amount)) )
	if spring > 1 then show_tock() elseif tock then gui.set_enabled(tock, false) end
	local descText = "TIMEWARP_DESC"
	if amount >1 then descText = descText .. "_PLURAL" end
	gui.set_text(gui.get_node("card/text"), loc.get(descText, amount))
	animate_card()
end

local function refresh_all()
	if enabled then
		update_card(card)
	end
end

--[[******************************************
INPUT
********************************************]]

function on_input(self, action_id, action)
	if action_id ~= nil and enabled then
		if action_id == hash("touch") and action.pressed and not pause then
			msg.post(controller, "show_dungeonmine")
		end
	end
end

--[[******************************************
MESSAGES
********************************************]]

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		enabled = message.enabled
		print(string.upper(currentPage), "enabled", enabled)
		gui.set_enabled(gui.get_node("root"), enabled)
		msg.post("main:/background#background", "set_enabled", { enabled = enabled, effect = { type = "tunnel", texture = "backgrounds", flipbook = "warp" } })
		if enabled then
			pause = true
			amount = message.amount or nil
			spring = message.spring or 1
			base = message.base or amount
			refresh_all()
		end
	elseif message_id == hash("refresh_all") then
		if not card.message and card.type and card.id then
			card = defsave.get(card.type, card.id)
		end
		refresh_all()
	end
end

function update()
	layout_screen()
end
