--[[ Reset progress is irreversible, so it takes a deliberate hold and then a
confirmation, never a single tap. The fill makes the wait visible: without it
three seconds of nothing reads as a dead button and the player lets go at two. ]]
local RESET_HOLD_TIME = 3
local RESET_HINT_TIME = 2
local TOUCH = hash("touch")
local reset = { holding = false, t = 0, item = nil, fill = nil, hint = 0 }

local function reset_item(list)
	for i,item in ipairs(list.items) do
		if item.data ~= nil and item.data.navigationMessage == "reset_statistics" then return item end
	end
end

local function set_resetfill(progress)
	if not reset.item then return end
	local root = reset.item.nodes[hash("options/listitem")]
	local size = gui.get_size(root)
	if not reset.fill then
		reset.fill = gui.new_box_node(vmath.vector3(-size.x / 2, 0, 0), vmath.vector3(0, size.y, 0))
		gui.set_pivot(reset.fill, gui.PIVOT_W)
		gui.set_color(reset.fill, vmath.vector4(0.89, 0.29, 0.29, 0.55))
		gui.set_parent(reset.fill, root)
		gui.move_below(reset.fill, reset.item.nodes[hash("options/listitem/text")])
	end
	gui.set_enabled(reset.fill, progress > 0)
	gui.set_size(reset.fill, vmath.vector3(size.x * progress, size.y, 0))
end

local function end_hold()
	reset.holding = false
	reset.t = 0
	set_resetfill(0)
end

local function start_hold(item)
	reset.holding = true
	reset.t = 0
	reset.hint = 0
	reset.item = item
	gui.set_text(item.nodes[hash("options/listitem/text")], item.data.listText)
end

local function abort_hold()
	if not reset.holding then return end
	end_hold()
	-- Letting go early has to say why nothing happened.
	gui.set_text(reset.item.nodes[hash("options/listitem/text")], "keep holding for 3 seconds")
	reset.hint = RESET_HINT_TIME
end

local function open_confirm()
	end_hold()
	msg.post(controller, "popup_confirm", {
		title = loc.get("RESET_PROGRESS_CONFIRM_TITLE"),
		text = loc.get("RESET_PROGRESS_CONFIRM_MESSAGE"),
		msgpost = { message_id = "reset_statistics", message = {} }
	})
end

function init(self)
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)
	gui.set_render_order(15)
end

function update(self, dt)
	if reset.holding then
		reset.t = reset.t + dt
		set_resetfill(math.min(1, reset.t / RESET_HOLD_TIME))
		if reset.t >= RESET_HOLD_TIME then open_confirm() end
	elseif reset.hint > 0 then
		reset.hint = reset.hint - dt
		if reset.hint <= 0 and reset.item then
			gui.set_text(reset.item.nodes[hash("options/listitem/text")], reset.item.data.listText)
		end
	end
end

local function update_optionText(list)
	for i,item in ipairs(list.items) do
		if item.data ~= nil then
			local text = item.nodes[hash("options/listitem/text")]
			gui.set_text(text, item.data.listText) -- .. ":" ..  item.index)
		end
	end
end

local function refresh_all()
	options_list = {}
	local isDebug = sys.get_engine_info().is_debug
	for o,option in ipairs(options) do
		if isDebug or ( not isDebug and not option.debug ) then
			table.insert(options_list, option)
		end
	end
	update_optionText(gooey.dynamic_list("options", "options/stencil", "options/listitem", options_list))
end

local function on_item_selected(list)
	if list.items[list.selected_item].data ~= nil then
		-- Reset is driven by the hold in on_input, never by a tap.
		if list.items[list.selected_item].data.navigationMessage == "reset_statistics" then return end
		if not list.items[list.selected_item].data.disabled then
			msg.post("main:/menu#controller", list.items[list.selected_item].data.navigationMessage, list.items[list.selected_item].data.message)
		end
	end
end

function on_input(self, action_id, action)
	if enabled and active then
		gooey.button("navbar/backbutton/bg", 	action_id, action, function() msg.post(controller, "show_dungeonmine") end)
		local list = gooey.dynamic_list("options", "options/stencil", "options/listitem", options_list, action_id, action, nil, on_item_selected)
		if action_id == TOUCH then
			local item = reset_item(list)
			local over = item ~= nil and gui.pick_node(item.nodes[hash("options/listitem")], action.x, action.y)
			if action.pressed and over then
				start_hold(item)
			elseif action.released or (reset.holding and not over) then
				-- Releasing, or sliding off (which is also how the list scrolls), ends the hold.
				abort_hold()
			end
		end
	elseif reset.holding then
		end_hold()
	end
end

--[[******************************************
MESSAGES
********************************************]]

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		enabled = message.enabled
		print(string.upper(currentPage), "enabled", enabled)
		gui.set_enabled(gui.get_node("root"), enabled)
		if enabled then
			refresh_all()
			message.focus = "settings"
		end
		msg.post("main:/background#background", "set_enabled", message)
		msg.post("main:/overlay#header", "set_enabled", message)
	elseif message_id == hash("set_active") then
		active = message.active
	elseif message_id == hash("refresh_all") then
		if enabled then refresh_all() end
	elseif message_id == hash("layout_changed") then
		gooey.dynamic_list("options", "options/stencil", "options/listitem", options_list).scroll_to(0,0)
		update_optionText(gooey.dynamic_list("options", "options/stencil", "options/listitem", options_list))
	end
end
