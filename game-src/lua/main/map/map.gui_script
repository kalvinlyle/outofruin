local random = require('random/random')
local progress = require('progress/progress')
local saveload = require('saveload/saveload')

local productName = "OoR"
local currentPage = "map"
local controller	= "main:/menu#controller"
local enabled = false

local map_id = 1
local map_data = {}
local quest_data = {}

local xoffset = 0
local pos = 0
local root_start_x = 0
local root_min_x = 0
local root_max_x = 0

local mapnodes = {
	"dungeon_1", "dungeon_2", "dungeon_3", "dungeon_4", "dungeon_5", "dungeon_6", "dungeon_7", "dungeon_8", "dungeon_9",
}

local mappaths = {
	"path_1x2", "path_1x4",
	"path_2x3",	"path_2x4", "path_2x5",
	"path_3x5", "path_3x6",
	"path_4x5", "path_4x7",
	"path_5x6", "path_5x7", "path_5x8",
	"path_6x8", "path_6x9",
	"path_7x8",
	"path_8x9"
}

--[[******************************************
					SCREEN FIT
********************************************]]

--[[ The scene is drawn for a 750x1334 phone and Defold fits that rectangle
into the window, so on any other shape the room left over turns into margin
and anything full bleed stops reaching the edges. The root goes on a plain
uniform fit, and the parts that have to touch an edge are placed against the
real one. The long version of this note is in main/nav/header.gui_script. ]]
local DESIGN_W = 750
local DESIGN_H = 1334
local HEADER_DEPTH = 255.5	-- underside of the header's top bar, from the top edge
local FOOTER_TOP = 105		-- top of the header's bottom bar, from the bottom edge

local screen = { w = 0, h = 0 }

-- The screen in design units, or nil if it has not changed since last call.
local function screen_changed()
	local ww, wh = window.get_size()
	local scale = math.min(ww / DESIGN_W, wh / DESIGN_H)
	local w, h = ww / scale, wh / scale
	if math.abs(w - screen.w) < 1 and math.abs(h - screen.h) < 1 then return nil end
	screen.w, screen.h = w, h
	local root = gui.get_node("root")
	gui.set_adjust_mode(root, gui.ADJUST_FIT)
	gui.set_xanchor(root, gui.ANCHOR_NONE)
	gui.set_yanchor(root, gui.ANCHOR_NONE)
	return w, h
end

local function screen_left()	return (DESIGN_W - screen.w) / 2 end
local function screen_bottom()	return (DESIGN_H - screen.h) / 2 end
local function screen_top()		return screen_bottom() + screen.h end
local function content_top()	return screen_top() - HEADER_DEPTH end
local function content_bottom()	return screen_bottom() + FOOTER_TOP end

local function place(id, x, y)
	local node = gui.get_node(id)
	local p = gui.get_position(node)
	gui.set_position(node, vmath.vector3(x or p.x, y or p.y, p.z))
	return node
end

local function resize(id, w, h)
	local node = gui.get_node(id)
	local s = gui.get_size(node)
	gui.set_size(node, vmath.vector3(w or s.x, h or s.y, s.z))
	return node
end

local function layout_screen()
	local w, h = screen_changed()
	if not w then return end
	place("map/clip", screen_left(), screen_bottom())
	resize("map/clip", w, h)
	-- The map is one drawing, so it is scaled to cover rather than stretched.
	local cover = math.max(w / DESIGN_W, h / DESIGN_H)
	gui.set_scale(gui.get_node("map/bg"), vmath.vector3(cover, cover, 1))
	place("map/bg", screen_left(), screen_bottom())
end

--[[******************************************
					FUNCTIONS
********************************************]]

function init(self)
	layout_screen()
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)

	root_max_x = gui.get_position(gui.get_node("map/bg")).x
	-- How far the map may be dragged: its own size less what the screen shows.
	root_min_x = root_min_x - gui.get_size(gui.get_node("map/bg")).x * gui.get_scale(gui.get_node("map/bg")).x + screen.w
end

local function refresh_all()
	if enabled then
		local Stats = saveload.load_data(productName, "Stats")
		local Rep = saveload.load_data(productName, "Rep")

		quest_data = Rep[Stats.Rank].Bounties
		
		map_data = saveload.load_data(productName, "Map")[map_id]
		print(string.upper(currentPage) .. " dungeon data loaded") --, inspect(map_data))
		for i in ipairs(map_data) do
			gui.set_enabled(gui.get_node(map_data[i]["Node"] .. "/tab"), map_data[i]["enabled"])
			if map_data[i].Levels[1]["Damage"] == 0 and map_data[i].Level == 1 then
				gui.play_flipbook(gui.get_node(map_data[i]["Node"] .. "/tab"), "tab_explore")
			else
				local match = false
				for n in ipairs(quest_data) do
					if quest_data[n]["mapNode"] == map_data[i]["Node"] and quest_data[n]["Status"] == "Read" then
						match = true
						break
					end
				end

				if match then 
					gui.play_flipbook(gui.get_node(map_data[i]["Node"] .. "/tab"), "tab_quest")
				else
					gui.play_flipbook(gui.get_node(map_data[i]["Node"] .. "/tab"), "tab_open")
				end
			end
		end
	end
end

--[[******************************************
					INPUT
********************************************]]

local function on_mapbutton_pressed(nodeid)
	msg.post(controller, "show_dungeonmine", { map_id = map_id, dungeon_id = nodeid })
end

local function on_kingdom_pressed(list)
	msg.post(controller, "focus_kingdom", { status = true })
	msg.post(controller, "show_kingdom", { map_id = map_id } )
end

local function on_farm_pressed(list) 			on_mapbutton_pressed(1)	end
local function on_desertruin_pressed(list) 		on_mapbutton_pressed(2)	end
local function on_forestruin_pressed(list) 		on_mapbutton_pressed(3)	end
local function on_mountainruin_pressed(list) 	on_mapbutton_pressed(4)	end
local function on_ancientmine_pressed(list) 	on_mapbutton_pressed(5)	end

function on_input(self, action_id, action)
	if action_id ~= nil and enabled then
		if action.pressed then
			xoffset = action.screen_x
			pos = gui.get_position(gui.get_node("map/bg"))
			root_start_x = pos.x
		elseif action.released then
		end
		pos.x = root_start_x + ( action.screen_x - xoffset )
		if pos.x < root_min_x then pos.x = root_min_x end
		if pos.x > root_max_x then pos.x = root_max_x end
		gui.set_position(gui.get_node("map/bg"), pos)
		gooey.button("kingdom/bg", action_id, action, on_kingdom_pressed)
		gooey.button("loc/farm/tab", action_id, action, on_farm_pressed, update_farm_button)
		gooey.button("loc/desert_ruin/tab", action_id, action, on_desertruin_pressed, update_desertruin_button)
		gooey.button("loc/forest_ruin/tab", action_id, action, on_forestruin_pressed, update_forestruin_button)
		gooey.button("loc/mountain_ruin/tab", action_id, action, on_mountainruin_pressed, update_mountainruin_button)
		gooey.button("loc/mine/tab", action_id, action, on_ancientmine_pressed, update_ancientmine_button)
	end
end

--[[******************************************
MESSAGES
********************************************]]

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		print(string.upper(currentPage), "enabled", enabled)
		enabled = message.enabled
		gui.set_enabled(gui.get_node("root"), enabled)
		if enabled then
			msg.post("main:/overlay#nav", "set_enabled", {enabled = false})

			if message.map_id ~= nil then map_id = message.map_id end
			msg.post(controller, "focus_kingdom", { status = false })
			refresh_all()
		end
		msg.post("main:/overlay#back", "set_enabled", {enabled = message.enabled})
	elseif message_id == hash("refresh_all") then
		refresh_all()
	end
end

function update()
	layout_screen()
end
