local gooey 		= require('gooey.gooey')
local inspect 		= require('inspect')
local random 		= require('random/random')
local progress 		= require('progress/progress')
local defsave 		= require('defsave/defsave')
local actions 		= require('actions')
local loc 			= require("shared.locsheets")

local productName = "OoR"
local currentPage = "cards"
local controller = "main:/menu#controller"
local enabled = false
local active = true

local cards_list_cols = {}
local totalColumns = 3
local sortIndex = 3
local sortModes = {
	{ display = "Type", 	mode = "Type",			order = true	}, 
	{ display = "Rarity", 	mode = "RarityOrder",	order = false	}, 
	{ display = "Upgrade", 	mode = "Progress",		order = false	}, 
	{ display = "Level", 	mode = "Level",			order = false	}, 
	{ display = "Chapter", 	mode = "Rank",			order = true	}, 
}

local color = {
	Common 			= "tinyfancybutton_darkgrey",
	Wild 			= "tinyfancybutton_brown",
	Rare 			= "tinyfancybutton_green",
	Epic 			= "tinyfancybutton_blue",
	Legendary 		= "tinyfancybutton_purple",
	Exotic 			= "tinyfancybutton_orange"
}

local order = {
	Common = 1,
	Wild = 2,
	Rare = 3,
	Epic = 4,
	Legendary = 5,
	Exotic = 6
}

--[[******************************************
					SCREEN FIT
********************************************]]

--[[ The scene is drawn for a 750x1334 phone and Defold fits that rectangle
into the window, so on any other shape the room left over turns into margin
and anything full bleed stops reaching the edges. The root goes on a plain
uniform fit, and the parts that have to touch an edge are placed against the
real one. The long version of this note is in main/nav/header.gui_script. ]]
local DESIGN_W = 750
local DESIGN_H = 1334
local HEADER_DEPTH = 255.5	-- underside of the header's top bar, from the top edge
local FOOTER_TOP = 105		-- top of the header's bottom bar, from the bottom edge

local screen = { w = 0, h = 0 }

-- The screen in design units, or nil if it has not changed since last call.
local function screen_changed()
	local ww, wh = window.get_size()
	local scale = math.min(ww / DESIGN_W, wh / DESIGN_H)
	local w, h = ww / scale, wh / scale
	if math.abs(w - screen.w) < 1 and math.abs(h - screen.h) < 1 then return nil end
	screen.w, screen.h = w, h
	local root = gui.get_node("root")
	gui.set_adjust_mode(root, gui.ADJUST_FIT)
	gui.set_xanchor(root, gui.ANCHOR_NONE)
	gui.set_yanchor(root, gui.ANCHOR_NONE)
	return w, h
end

local function screen_left()	return (DESIGN_W - screen.w) / 2 end
local function screen_bottom()	return (DESIGN_H - screen.h) / 2 end
local function screen_top()		return screen_bottom() + screen.h end
local function content_top()	return screen_top() - HEADER_DEPTH end
local function content_bottom()	return screen_bottom() + FOOTER_TOP end

local function place(id, x, y)
	local node = gui.get_node(id)
	local p = gui.get_position(node)
	gui.set_position(node, vmath.vector3(x or p.x, y or p.y, p.z))
	return node
end

local function resize(id, w, h)
	local node = gui.get_node(id)
	local s = gui.get_size(node)
	gui.set_size(node, vmath.vector3(w or s.x, h or s.y, s.z))
	return node
end

local function layout_screen()
	local w, h = screen_changed()
	if not w then return end
	-- Tab bar under the header, card grid filling what is left above the footer.
	place("navbar/bg", nil, content_top() - 41.5)
	resize("navbar/bg", w, nil)
	local top = content_top() - 83.5
	local height = top - (content_bottom() - 5)
	place("cards/stencil", nil, top)
	resize("cards/stencil", w, height)
	-- Each column clips its own list, so they get the new height too, and
	-- spread across the width rather than sitting 240 apart.
	for i = 1, 3 do
		place("cards/stencil/col/" .. i, (i - 2) * w * 0.32, nil)
		resize("cards/stencil/col/" .. i, nil, height - 15)
	end
end

function init(self)
	layout_screen()
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)
	for i=1, totalColumns do cards_list_cols[i] = {} end
	gui.set_render_order(5)
	gui.set_color(gui.get_node("navbar/title"), actions.get_color("darkbrown"))
end

--[[******************************************
				FUNCTIONS
********************************************]]

local function update_cards(list, column)

	for i,item in ipairs(list.items) do
		if actions.tablelength(item.data) > 0 then
			gui.set_enabled( item.nodes[hash("card/col/" .. column)], true)

			local imageNode = item.nodes[hash("card/image/col/" .. column)]
			local panelNode = item.nodes[hash("card/panel/bg/col/" .. column)]
			if item.data.Portrait then 
				gui.set_texture(imageNode, item.data.Portrait.texture)
				gui.play_flipbook(imageNode, item.data.Portrait.flipbook)
			elseif item.data.Icon then 
				gui.set_texture(imageNode, item.data.Icon.texture)
				gui.play_flipbook(imageNode, item.data.Icon.flipbook)
			end

			local shadowNode = item.nodes[hash("card/shadow/col/" .. column)]
			local locktextNode = item.nodes[hash("card/lock/text/col/" .. column)]
			gui.set_enabled(shadowNode, item.data.Locked)
			gui.set_text(locktextNode, "Unlock at Chapter " .. item.data.Rank + 1)

			local progressbgNode = item.nodes[hash("card/progress/bg/col/" .. column)]
			local progressbarNode = item.nodes[hash("card/progress/bar/col/" .. column)]
			local leveltextNode = item.nodes[hash("card/level/col/" .. column)]
			local progressbgSize = gui.get_size(progressbgNode)
			local progressbarSize = vmath.vector3(progressbgSize.x * math.min(1, math.max(0, item.data.Progress)), progressbgSize.y, progressbgSize.z)
			gui.set_enabled(progressbgNode, not item.data.Locked)
			gui.set_size(progressbarNode, progressbarSize)
			gui.set_text(leveltextNode, "LEVEL " .. item.data.Level)

			local upgradeNode = item.nodes[hash("card/lvlupbox/col/" .. column)]
			local upgradeglintNode = item.nodes[hash("card/lvlupglint/col/" .. column)]
			gui.set_enabled(upgradeNode, item.data.Progress >= 1 and item.data.Status == "Unlocked" )

			if item.data.Cost then
				gui.set_text(item.nodes[hash("card/lvlupbox/cost/col/" .. column)], item.data.Cost .. " XP")
				gui.play_flipbook(item.nodes[hash("card/lvlupbox/col/" .. column)], "tinyfancybutton_green")
			end

			if gui.get_flipbook(upgradeglintNode) == hash("button_glint_static") then 
				gui.play_flipbook(upgradeglintNode, "button_glint")
			end

			if item.data.Rarity then
				gui.play_flipbook(panelNode, color[item.data.Rarity])
			end
		else
			gui.set_enabled( item.nodes[hash("card/col/" .. column)], false)
		end
	end
end

local function split_table_into_columns(table, numColumns)
	local col,row = 1, 1
	local column_data = {}; for i=1,numColumns do column_data[i] = {} end
	for k,item in ipairs(table) do
		if col == 1 then
			for i=1,numColumns do column_data[i][row] = {} end
		end
		column_data[col][row] = item
		col = col + 1; if col > numColumns then row = row + 1; col = 1 end
	end
	return column_data
end

local function sort_cards(data, field1, field2, direction)
	table.sort(data, function(a,b)
		assert(a[field1], "field " .. field1 .. " does not exist in " .. a.Name)
		assert(a[field2], "field " .. field2 .. " does not exist in " .. a.Name)
		assert(b[field1], "field " .. field1 .. " does not exist in " .. b.Name)
		assert(b[field2], "field " .. field2 .. " does not exist in " .. b.Name)
		if direction then 
			if a[field1] < b[field1] then
				return true
			elseif a[field1] > b[field1] then
				return false
			else
				return a[field2] < b[field2]
			end
		else
			if a[field1] > b[field1] then
				return true
			elseif a[field1] < b[field1] then
				return false
			else
				return a[field2] < b[field2]
			end
		end
	end)
	return data
end

local function ingest_cards(data, type)
	local maxRank = #defsave.loaded.Ranks.data
	local cardNum = 0
	local deck = {}
	for c in ipairs(data) do
		data[c].Rank = data[c].Rank or c
		if data[c].Rank <= maxRank then
			cardNum = cardNum + 1
			deck[cardNum] = data[c]
			deck[cardNum].Type = data[c].Type or type
			deck[cardNum].id = data[c].id or c
			deck[cardNum].Rank = data[c].Rank or c
			deck[cardNum].Progress = data[c].Progress or 0
			deck[cardNum].RarityOrder = order[data[c].Rarity] or c
			deck[cardNum].Locked = data[c].Locked or data[c].Status == "Locked"
		end
	end
	return deck
end

local function get_cards(type)
	local data = actions.load_all_savedata(type)
	data = ingest_cards(data, type)
	data = sort_cards(data, "Rank", "Name", true)
	return data
end

local function refresh_all()
	local cards_list = {}

	cards_list = actions.tableConcat(cards_list, get_cards("Hero"))
	cards_list = actions.tableConcat(cards_list, get_cards("Henchmen"))
	cards_list = actions.tableConcat(cards_list, get_cards("Gear"))

	if sortModes[sortIndex].mode ~= "Type" then
		cards_list = sort_cards(cards_list, sortModes[sortIndex].mode, "Rank", sortModes[sortIndex].order)
	end

	cards_list_cols = split_table_into_columns(cards_list, totalColumns)

	if cards_list_cols ~= nil then
		for i in ipairs(cards_list_cols) do
			if cards_list_cols[i] then
				update_cards(gooey.dynamic_list("cards", "cards/stencil/col/" .. i, "card/col/" .. i, cards_list_cols[i]), i)
			end
		end
	end

	local unlockedCards = 0
	for c,card in ipairs(cards_list) do
		if not card.Locked then unlockedCards = unlockedCards + 1 end
	end
	
	gui.set_text(gui.get_node("navbar/label/sortMode"), string.upper(sortModes[sortIndex].display))
	gui.set_text(gui.get_node("navbar/count"), unlockedCards .. "/" .. #cards_list)
end

function update(self)
	layout_screen()
	if enabled then
		refresh_all()
	end
end

--[[******************************************
					INPUT
********************************************]]

local function update_sortbutton_sortmode(button)	gui.set_text(gui.get_node("navbar/label/sortMode"), string.upper(sortModes[sortIndex].display)) end

local function update_cards_col(num, list)	
	for i=1, totalColumns do
		if i ~= num then
			gooey.dynamic_list("cards", "cards/stencil/col/" .. i, "card/col/" .. i, cards_list_cols[i]).scroll_to(0, list.scroll.y)
		end
	end
end

local function update_cards_col1(list)	update_cards_col(1, list) end
local function update_cards_col2(list)	update_cards_col(2, list) end
local function update_cards_col3(list)	update_cards_col(3, list) end

local function on_sort_pressed_sortmode(button)
	sortIndex = sortIndex + 1
	if sortIndex > #sortModes then sortIndex = 1 end
	gooey.dynamic_list("cards", "cards/stencil/col/1", "cards/col/1", cards_list_cols[1], action_id, action).scroll_to(0,0)
	gooey.dynamic_list("cards", "cards/stencil/col/2", "cards/col/2", cards_list_cols[2], action_id, action).scroll_to(0,0)
	gooey.dynamic_list("cards", "cards/stencil/col/3", "cards/col/3", cards_list_cols[3], action_id, action).scroll_to(0,0)
end

local function on_item_pressed(list, cards, column)
	if active then
		local item = list.items[list.selected_item]
		for l,level in ipairs(list.items) do
			if list.selected_item == level.index then
				item = list.items[l]
				break
			end
		end

		item.data.Progress = item.data.Progress or 0
		item.data.Cost = item.data.Cost or 0

		if item.data.Type == "Henchmen" then
			if item.data.Cost > defsave.get("Currency", "Xp") and item.data.Progress >= 1 then
				msg.post(controller, "show_shop", { complete_purchase_callback = "cards" } )
			elseif item.data.Progress >= 1 then
				msg.post(controller, "show_upgradecard", { type = "Henchmen", id = item.data.id, message_id = "levelup_henchmen", message = { henchmen_id = item.data.id, complete_purchase_callback = "cards" }})
			else
				msg.post(controller, "popup_henchmen", { henchmen_id = item.data.id } )
			end

		elseif item.data.Type == "Gear" then
			if item.data.Cost > defsave.get("Currency", "Xp") and item.data.Progress >= 1 then
				msg.post(controller, "show_shop", { complete_purchase_callback = "cards" } )
			elseif item.data.Progress >= 1 then
				msg.post(controller, "show_upgradecard", { type = "Gear", id = item.data.id, message_id = "levelup_gear", message = { gear_id = item.data.id, complete_purchase_callback = "cards" }})
			else
				local id = 0
				for h,henchmen in ipairs(defsave.loaded.Henchmen.data) do
					if henchmen.map_id 		== 		item.data.map_id 		and
					henchmen.dungeon_id 	== 		item.data.dungeon_id 	and
					henchmen.level_id 		== 		item.data.level_id 		then
						id = henchmen.id
						break
					end
				end
				msg.post(controller, "popup_henchmen", { henchmen_id = id } )
			end
		elseif item.data.Type == "Hero" then
			if item.data.Cost > defsave.get("Currency", "Xp") and item.data.Progress >= 1 then
				msg.post(controller, "show_shop", { complete_purchase_callback = "cards" } )
			elseif item.data.Progress >= 1 then
				msg.post(controller, "show_upgradecard", { type = "Hero", id = item.data.id, message_id = "levelup_hero", message = { hero_id = item.data.id, complete_purchase_callback = "cards" }})
			end
		end
	end
end

local function on_item_pressed_col1(list) on_item_pressed(list, cards_list_cols[1], 1) end
local function on_item_pressed_col2(list) on_item_pressed(list, cards_list_cols[2], 2) end
local function on_item_pressed_col3(list) on_item_pressed(list, cards_list_cols[3], 3) end

function on_input(self, action_id, action)
	if action_id ~= nil and enabled and active then
		gooey.button("navbar/button/sortMode", 	action_id, action, on_sort_pressed_sortmode, 	update_sortbutton_sortmode)
		gooey.button("navbar/backbutton/bg", 	action_id, action, function() msg.post(controller, "show_dungeonmine") end)
		
		gooey.dynamic_list("cards", "cards/stencil/col/1", "card/col/1", cards_list_cols[1], action_id, action, nil, on_item_pressed_col1, update_cards_col1)
		gooey.dynamic_list("cards", "cards/stencil/col/2", "card/col/2", cards_list_cols[2], action_id, action, nil, on_item_pressed_col2, update_cards_col2)
		gooey.dynamic_list("cards", "cards/stencil/col/3", "card/col/3", cards_list_cols[3], action_id, action, nil, on_item_pressed_col3, update_cards_col3)
	end
end

--[[******************************************
					MESSAGES
********************************************]]

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		enabled = message.enabled
		print(string.upper(currentPage), "enabled", enabled)
		gui.set_enabled(gui.get_node("root"), enabled)
		if enabled then
			refresh_all()
			message.focus = "cards"
		end
		msg.post("main:/background#background", "set_enabled", message)
		msg.post("main:/overlay#header", "set_enabled", message)
	elseif message_id == hash("set_active") then
		active = message.active
	elseif message_id == hash("refresh_all") then
		refresh_all()
	elseif message_id == hash("layout_changed") then
		for c=1, totalColumns do
			gooey.dynamic_list("cards", "cards/stencil/col/" .. c, "card/col/" .. c, cards_list_cols[c]).scroll_to(0, 0)
		end
	end
end
