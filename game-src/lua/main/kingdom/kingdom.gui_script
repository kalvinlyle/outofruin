local gooey = require('gooey.gooey')
local inspect = require('inspect')
local random = require('random/random')
local progress = require('progress/progress')
local saveload = require('saveload/saveload')
local defsave = require('defsave/defsave')
local actions = require('actions')
local loc = require("shared.locsheets")

local productName = "OoR"
local currentPage = "kingdom"
local controller	= "main:/menu#controller"
local enabled = false

local NODES = 31
local map_list = {}
local mapNodes = {}

--[[ The world map is how players move between the main game (map 1) and live
events (map 2 onwards). Map 1's pin is always there and returns to the player's
lands; an event's pin shows while it runs, with its name and time left. The
next event's place shows a "Something stirs" pin counting down to its start,
which says only a little of what is coming. ]]
local MAIN_MAP = 1
local pins = {}
local STIRS = "stirs"	-- the pins key of the next event's pin

-- The world-map location each map's pin and "!" tab hang off.
-- Night of the Wererabbit on the Stonetalon Cliffs, What Sleeps in Titans
-- Well on its shore, The Midnight Carnival outside a Sylvir Coast town, The
-- Longest Night in the Titan Mountains, The Blackmaw Siege at the top of
-- them. Each event's place is near enough the next one's that a phone frames
-- the live pin and "Something stirs" together.
local MAP_NODE = { [1] = 1, [2] = 2, [3] = 7, [4] = 3, [5] = 20, [6] = 30 }
local EVENT_PANEL = { WEREMOON = "tinyfancypanel_red", TITANSWELL = "tinyfancypanel_darkblue",
	MIDNIGHT = "tinyfancypanel_purple", LONGNIGHT = "tinyfancypanel_blue", BLACKMAW = "tinyfancypanel_gold" }
local STIRS_PANEL = "tinyfancypanel_darkgrey"

local function map_of_node(node)
	for map_id,n in pairs(MAP_NODE) do
		if n == node then return map_id end
	end
end

local function new_text(font, pos, size, scale, parent)
	local node = gui.new_text_node(pos, "")
	gui.set_font(node, font)
	gui.set_size(node, size)
	gui.set_scale(node, vmath.vector3(scale, scale, 1))
	gui.set_parent(node, parent)
	return node
end

local function new_panel(flipbook, pos, size, parent)
	local node = gui.new_box_node(pos, size)
	gui.set_texture(node, "main")
	gui.play_flipbook(node, flipbook)
	gui.set_slice9(node, vmath.vector4(16, 22, 32, 42))
	gui.set_parent(node, parent)
	return node
end

-- A pin's box grows to its text, and the text shrinks only past the widest box.
local PIN_Y = 128
local PIN_H = 90
local PIN_MIN_W = 240
local PIN_MAX_W = 560
local PIN_PAD = 56
local TITLE_SCALE = 0.5
local TIMER_SCALE = 0.9

local PIN_BELOW_Y = -88	-- under the location instead, when two pins would collide

-- Pins hang off holders added after every location, on the top layer, so
-- they draw over the other locations.
local function build_pin(key, map_id, flipbook)
	local pin = { map_id = map_id }
	local at = gui.get_position(gui.get_node("node_" .. MAP_NODE[map_id]))
	pin.holder = gui.new_box_node(vmath.vector3(at.x, at.y, 0), vmath.vector3(0, 0, 0))
	gui.set_parent(pin.holder, gui.get_node("kingdom/bg"))
	pin.bg = new_panel(flipbook, vmath.vector3(0, PIN_Y, 0), vmath.vector3(PIN_MIN_W, PIN_H, 0), pin.holder)
	pin.title = new_text("title", vmath.vector3(0, 14, 0), vmath.vector3(620, 40, 0), TITLE_SCALE, pin.bg)
	pin.timer = new_text("font", vmath.vector3(0, -20, 0), vmath.vector3(560, 36, 0), TIMER_SCALE, pin.bg)
	for _,node in ipairs({ pin.bg, pin.title, pin.timer }) do gui.set_layer(node, "Tabs") end
	pins[key] = pin
end

-- Moves the stirs pin to the next event's place.
local function move_pin(pin, map_id)
	if pin.map_id == map_id then return end
	pin.map_id = map_id
	local at = gui.get_position(gui.get_node("node_" .. MAP_NODE[map_id]))
	gui.set_position(pin.holder, vmath.vector3(at.x, at.y, 0))
end

local function fit_pin(pin)
	local timed = gui.get_text(pin.timer) ~= ""
	local title_w = gui.get_text_metrics_from_node(pin.title).width * TITLE_SCALE
	local timer_w = timed and gui.get_text_metrics_from_node(pin.timer).width * TIMER_SCALE or 0
	local w = math.max(PIN_MIN_W, math.min(PIN_MAX_W, math.max(title_w, timer_w) + PIN_PAD))
	local room = w - PIN_PAD
	local title = TITLE_SCALE * math.min(1, room / math.max(title_w, 1))
	local timer = TIMER_SCALE * math.min(1, room / math.max(timer_w, 1))
	gui.set_size(pin.bg, vmath.vector3(w, PIN_H, 0))
	gui.set_scale(pin.title, vmath.vector3(title, title, 1))
	gui.set_scale(pin.timer, vmath.vector3(timer, timer, 1))
	gui.set_position(pin.title, vmath.vector3(0, timed and 14 or 4, 0))
end

local function current_event()
	return defsave.loaded.Stats and defsave.get("Stats", "Event")
end

--[[ The dev menu, bottom left, only on a local dev server. "All events live"
puts every event's pin up at once; tapping one that is not the live event
makes it the live event (repController's dev_event) and opens it, without
paying anything out, and each event keeps its chapter. Turning it off goes back
to the schedule. ]]
local DEV_HOSTS = { localhost = true, ["127.0.0.1"] = true, ["[::1]"] = true }
local DEV_KEY = "DevAllEvents"
local dev = nil		-- the menu's nodes, on a dev server only

local function dev_all_events()
	return dev and defsave.loaded.Stats ~= nil and defsave.get("Stats", DEV_KEY) == true
end

-- The event after the live one, while it is still to come.
local function next_event()
	local event = current_event()
	if not event then return nil end
	local upcoming, starts_at = actions.next_event(os.time())
	if upcoming.map_id == event.map_id then return nil end
	return upcoming, starts_at
end

local function refresh_pins()
	local event = current_event()
	gui.set_text(pins[MAIN_MAP].title, string.upper(loc.get("WORLDMAP_HOME")))
	gui.set_text(pins[MAIN_MAP].timer, "")
	for key,pin in pairs(pins) do
		if key ~= MAIN_MAP and key ~= STIRS then
			local live = event ~= nil and event.map_id == key
			gui.set_enabled(pin.bg, live or dev_all_events())
			if not live and dev_all_events() then
				local listed = actions.event_on_map(key)
				gui.set_text(pin.title, string.upper(loc.get("EVENT_" .. listed.key .. "_NAME")))
				gui.set_text(pin.timer, "Dev: tap to play")
			elseif live then
				gui.set_text(pin.title, string.upper(loc.get("EVENT_" .. event.key .. "_NAME")))
				local countdown = actions.format_countdown(event.ends_at - os.time())
				if event.part_done then
					-- The next part comes with this event's next run, after the others'.
					countdown = actions.format_countdown(actions.event_returns_at(event.ends_at) - os.time())
				end
				gui.set_text(pin.timer, loc.get(event.part_done and "EVENT_NEXT_PART_IN" or "EVENT_ENDS_IN", { countdown }))
			end
		end
	end
	local stirs = pins[STIRS]
	local upcoming, starts_at = next_event()
	if dev_all_events() then upcoming = nil end
	gui.set_enabled(stirs.bg, upcoming ~= nil)
	if upcoming then
		move_pin(stirs, upcoming.map_id)
		gui.set_text(stirs.title, string.upper(loc.get("WORLDMAP_STIRS")))
		gui.set_text(stirs.timer, loc.get("WORLDMAP_STIRS_IN", { actions.format_countdown(starts_at - os.time()) }))
	end
	for key,pin in pairs(pins) do fit_pin(pin) end
end

--[[******************************************
					SCREEN FIT
********************************************]]

--[[ The scene is drawn for a 750x1334 phone and Defold fits that rectangle
into the window, so on any other shape the room left over turns into margin
and anything full bleed stops reaching the edges. The root goes on a plain
uniform fit, and the parts that have to touch an edge are placed against the
real one. The long version of this note is in main/nav/header.gui_script. ]]
local DESIGN_W = 750
local DESIGN_H = 1334
local HEADER_DEPTH = 255.5	-- underside of the header's top bar, from the top edge
local FOOTER_TOP = 105		-- top of the header's bottom bar, from the bottom edge

local screen = { w = 0, h = 0 }

-- The screen in design units, or nil if it has not changed since last call.
local function screen_changed()
	local ww, wh = window.get_size()
	local scale = math.min(ww / DESIGN_W, wh / DESIGN_H)
	local w, h = ww / scale, wh / scale
	screen.scale = scale
	if math.abs(w - screen.w) < 1 and math.abs(h - screen.h) < 1 then return nil end
	screen.w, screen.h = w, h
	local root = gui.get_node("root")
	gui.set_adjust_mode(root, gui.ADJUST_FIT)
	gui.set_xanchor(root, gui.ANCHOR_NONE)
	gui.set_yanchor(root, gui.ANCHOR_NONE)
	return w, h
end

local function screen_left()	return (DESIGN_W - screen.w) / 2 end
local function screen_bottom()	return (DESIGN_H - screen.h) / 2 end
local function screen_top()		return screen_bottom() + screen.h end
local function content_top()	return screen_top() - HEADER_DEPTH end
local function content_bottom()	return screen_bottom() + FOOTER_TOP end

local function place(id, x, y)
	local node = gui.get_node(id)
	local p = gui.get_position(node)
	gui.set_position(node, vmath.vector3(x or p.x, y or p.y, p.z))
	return node
end

local function resize(id, w, h)
	local node = gui.get_node(id)
	local s = gui.get_size(node)
	gui.set_size(node, vmath.vector3(w or s.x, h or s.y, s.z))
	return node
end

local apply_view

local function layout_screen()
	local w, h = screen_changed()
	if not w then return end
	place("kingdom/clip", screen_left(), screen_bottom())
	resize("kingdom/clip", w, h)
	if apply_view then apply_view() end
end

--[[******************************************
					VIEW
********************************************]]

--[[ The map opens framed on the pins (the player's lands and the live event),
and the player can drag it and zoom it with a pinch or the mouse wheel. It
never zooms out past the drawing's edges. The view is kept in the save as the
zoom and the map point at the middle of the screen, so it comes back the same
on any screen shape. ]]
local MAX_ZOOM = 2
local FIT_MAX_ZOOM = 1	-- framing the pins never zooms in past the art's own size
local WHEEL_STEP = 1.15
local FIT_MARGIN = 24	-- room left round the framed pins
local FIT_TOP = 170		-- the back button's corner
local TAP_SLOP = 12		-- how far a press may wander and still be a tap
local VIEW_KEY = "WorldMapView"

local SCROLL_UP = hash("scroll_up")
local SCROLL_DOWN = hash("scroll_down")
local MULTITOUCH = hash("multitouch")

local view = nil		-- { zoom, x, y }, x and y in map units
local drag = nil
local pinch = nil

-- A live pin as its map point and the room its label and icon take round it.
local function pin_item(pin)
	local p = gui.get_position(gui.get_node("node_" .. MAP_NODE[pin.map_id]))
	local half = gui.get_size(pin.bg).x / 2
	return { x = p.x, y = p.y, l = half, r = half, b = 40, t = PIN_Y + PIN_H / 2 }
end

-- Screen extent of the items along one axis at a zoom: lowest edge, highest edge.
local function span(items, zoom, axis, lo, hi)
	local a, b = math.huge, -math.huge
	for _,item in ipairs(items) do
		a = math.min(a, item[axis] * zoom - item[lo])
		b = math.max(b, item[axis] * zoom + item[hi])
	end
	return a, b
end

local function min_zoom()
	local size = gui.get_size(gui.get_node("kingdom/bg"))
	return math.max(screen.w / size.x, screen.h / size.y)
end

-- The largest zoom that fits the pins in the room under the back button,
-- looking at their middle. If they can't all fit, the live event's pin and
-- the "Something stirs" pin are framed without home, and if even those two
-- can't, the live event's alone.
local function fit_view()
	local all, event, stirs = {}, nil, nil
	for key,pin in pairs(pins) do
		if gui.is_enabled(pin.bg) then
			local item = pin_item(pin)
			table.insert(all, item)
			if key == STIRS then stirs = item elseif key ~= MAIN_MAP then event = item end
		end
	end
	local w = screen.w - 2 * FIT_MARGIN
	local h = screen.h - FIT_MARGIN - FIT_TOP
	local function fits(items, zoom)
		local x0, x1 = span(items, zoom, "x", "l", "r")
		local y0, y1 = span(items, zoom, "y", "b", "t")
		return x1 - x0 <= w and y1 - y0 <= h
	end
	local items = all
	if event and not fits(all, min_zoom()) then
		items = (stirs and fits({ event, stirs }, min_zoom())) and { event, stirs } or { event }
	end
	local lo, hi = min_zoom(), FIT_MAX_ZOOM
	if fits(items, hi) then
		lo = hi
	else
		for _=1,30 do
			local mid = (lo + hi) / 2
			if fits(items, mid) then lo = mid else hi = mid end
		end
	end
	local zoom = math.max(lo, min_zoom())
	local x0, x1 = span(items, zoom, "x", "l", "r")
	local y0, y1 = span(items, zoom, "y", "b", "t")
	local cx = (x0 + x1) / 2
	local cy = (y0 + y1) / 2 + (FIT_TOP - FIT_MARGIN) / 2
	if event then
		-- Slide just far enough to bring the event's whole pin on screen.
		cx = math.max(event.x * zoom + event.r - w / 2, math.min(event.x * zoom - event.l + w / 2, cx))
	end
	return { zoom = zoom, x = cx / zoom, y = cy / zoom }
end

-- Every pin sits above its location; the home pin drops below its own when
-- that would cover the event's.
local function place_pins()
	local home = pins[MAIN_MAP]
	local zoom = view.zoom
	local below = false
	for key,pin in pairs(pins) do
		gui.set_scale(pin.holder, vmath.vector3(1 / zoom, 1 / zoom, 1))
		if key ~= MAIN_MAP and gui.is_enabled(pin.bg) then
			local a, b = gui.get_position(home.holder), gui.get_position(pin.holder)
			local w = (gui.get_size(home.bg).x + gui.get_size(pin.bg).x) / 2
			below = below or (math.abs(a.x - b.x) * zoom < w and math.abs(a.y - b.y) * zoom < PIN_H)
		end
	end
	gui.set_position(home.bg, vmath.vector3(0, below and PIN_BELOW_Y or PIN_Y, 0))
end

-- The map can't be dragged or zoomed past its edges.
local function clamp_axis(origin, length, room)
	return math.max(room - length, math.min(0, origin))
end

apply_view = function()
	if not view then return end
	local bg = gui.get_node("kingdom/bg")
	local size = gui.get_size(bg)
	local zoom = math.max(min_zoom(), math.min(MAX_ZOOM, view.zoom))
	local x = clamp_axis(screen.w / 2 - view.x * zoom, size.x * zoom, screen.w)
	local y = clamp_axis(screen.h / 2 - view.y * zoom, size.y * zoom, screen.h)
	view.zoom = zoom
	view.x = (screen.w / 2 - x) / zoom
	view.y = (screen.h / 2 - y) / zoom
	gui.set_position(bg, vmath.vector3(x, y, 0))
	gui.set_scale(bg, vmath.vector3(zoom, zoom, 1))
	place_pins()
end

-- Which pins are up, and where: a saved view is only kept while they are the
-- same, so a new event or a new "Something stirs" is framed when it appears.
local function pins_shown()
	local shown = {}
	for key,pin in pairs(pins) do
		if gui.is_enabled(pin.bg) then table.insert(shown, tostring(key) .. "@" .. pin.map_id) end
	end
	table.sort(shown)
	return table.concat(shown, ",")
end

local function remember_view()
	if view and defsave.loaded.Stats then
		view.pins = pins_shown()
		defsave.set("Stats", VIEW_KEY, view)
		defsave.save("Stats")
	end
end

local function restore_view()
	local saved = defsave.loaded.Stats and defsave.key_exists("Stats", VIEW_KEY) and defsave.get("Stats", VIEW_KEY)
	if saved and saved.zoom and saved.pins == pins_shown() then
		view = { zoom = saved.zoom, x = saved.x, y = saved.y }
	else
		view = fit_view()
		remember_view()
	end
	apply_view()
end

-- A window position in screen units from the screen's bottom-left corner.
local function to_screen(x, y)
	return x / screen.scale, y / screen.scale
end

-- Zooms so the map point under (sx, sy) stays there.
local function zoom_at(sx, sy, zoom, mx, my)
	if not mx then
		local x = screen.w / 2 - view.x * view.zoom
		local y = screen.h / 2 - view.y * view.zoom
		mx, my = (sx - x) / view.zoom, (sy - y) / view.zoom
	end
	view.zoom = math.max(min_zoom(), math.min(MAX_ZOOM, zoom))
	view.x = mx + (screen.w / 2 - sx) / view.zoom
	view.y = my + (screen.h / 2 - sy) / view.zoom
	apply_view()
end

--[[******************************************
					FUNCTIONS
********************************************]]

function init(self)
	layout_screen()
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)

	for i=1,NODES do
		mapNodes[i] = gui.get_flipbook(gui.get_node("tab_" .. i))
	end
	build_pin(MAIN_MAP, MAIN_MAP, "tinyfancypanel_charcoal")
	for e,event in ipairs(actions.EVENTS) do
		build_pin(event.map_id, event.map_id, EVENT_PANEL[event.key])
	end
	build_pin(STIRS, actions.EVENTS[1].map_id, STIRS_PANEL)
end



local function update_node(node, map_id)
	if enabled then
		local event = current_event()
		local shown = map_id ~= nil and ((event ~= nil and event.map_id == map_id) or (dev_all_events() and actions.event_on_map(map_id) ~= nil))
		gui.set_enabled(node, map_id == MAIN_MAP or shown)
	end
end

local function refresh_all()
	if enabled then
		map_list = saveload.load_data(productName, "Map")
		print(string.upper(currentPage) .. " map data loaded") --, inspect(map_list))
		for i=1,NODES do
			update_node(gui.get_node("tab_" .. i), map_of_node(i))
		end
	end
end

--[[******************************************
					INPUT
********************************************]]

local function on_map_pressed(map_id)
	local event = current_event()
	if map_id == MAIN_MAP then
		msg.post(controller, "show_dungeonmine", { map_id = MAIN_MAP })
	elseif event ~= nil and event.map_id == map_id then
		msg.post(controller, "show_dungeonmine", { map_id = map_id, dungeon_id = 1 })
		msg.post(controller, "event_enter")
	elseif dev_all_events() and actions.event_on_map(map_id) then
		msg.post(controller, "dev_event", { key = actions.event_on_map(map_id).key, open = true })
	end
end

-- The next event's pin hints at what is coming.
local function on_stirs_pressed()
	local upcoming = next_event()
	if upcoming then
		msg.post(controller, "popup_message", { title = "WORLDMAP_STIRS_TITLE", text = "EVENT_" .. upcoming.key .. "_TEASER" })
	end
end

local DEV_BUTTON_W, DEV_BUTTON_H = 120, 64
local DEV_ROW_W, DEV_ROW_H = 400, 64
local DEV_MARGIN = 24

local function build_dev_menu()
	dev = false
	local ok, host = pcall(html5.run, "location.hostname")
	if not ok or not DEV_HOSTS[host] then return end
	local clip = gui.get_node("kingdom/clip")
	dev = { open = false }
	dev.button = new_panel("tinyfancypanel_charcoal", vmath.vector3(0, 0, 0), vmath.vector3(DEV_BUTTON_W, DEV_BUTTON_H, 0), clip)
	dev.label = new_text("title", vmath.vector3(0, 2, 0), vmath.vector3(200, 40, 0), 0.5, dev.button)
	gui.set_text(dev.label, "DEV")
	dev.row = new_panel("tinyfancypanel_darkgrey", vmath.vector3(0, 0, 0), vmath.vector3(DEV_ROW_W, DEV_ROW_H, 0), clip)
	dev.row_label = new_text("title", vmath.vector3(0, 2, 0), vmath.vector3(DEV_ROW_W * 2, 40, 0), 0.45, dev.row)
	for _,node in ipairs({ dev.button, dev.label, dev.row, dev.row_label }) do gui.set_layer(node, "Tabs") end
end

-- The button sits in the screen's bottom-left corner, the menu above it.
local function layout_dev_menu()
	if not dev then return end
	gui.set_position(dev.button, vmath.vector3(DEV_MARGIN + DEV_BUTTON_W / 2, DEV_MARGIN + DEV_BUTTON_H / 2, 0))
	gui.set_position(dev.row, vmath.vector3(DEV_MARGIN + DEV_ROW_W / 2, DEV_MARGIN * 1.5 + DEV_BUTTON_H + DEV_ROW_H / 2, 0))
	gui.set_enabled(dev.row, dev.open)
	gui.set_text(dev.row_label, "ALL EVENTS LIVE: " .. (dev_all_events() and "ON" or "OFF"))
	gui.play_flipbook(dev.row, dev_all_events() and "tinyfancypanel_green" or "tinyfancypanel_darkgrey")
end

local function toggle_all_events()
	local on = not dev_all_events()
	defsave.set("Stats", DEV_KEY, on)
	defsave.save("Stats", true)
	-- Off goes back to the event the schedule says is on.
	if not on and defsave.get("Stats", "DevEvent") then
		msg.post(controller, "dev_event", { key = nil })
	end
	refresh_all()
	refresh_pins()
	view = fit_view()
	remember_view()
	apply_view()
	layout_dev_menu()
end

-- True if the tap was on the dev menu.
local function on_dev_tap(action)
	if not dev then return false end
	if gui.pick_node(dev.button, action.x, action.y) then
		dev.open = not dev.open
		layout_dev_menu()
		return true
	elseif dev.open and gui.pick_node(dev.row, action.x, action.y) then
		toggle_all_events()
		return true
	end
	return false
end

-- A tap opens the map under it: a pin's label or its "!" tab.
local function on_tap(action)
	if on_dev_tap(action) then return end
	for key,pin in pairs(pins) do
		if gui.is_enabled(pin.bg) and gui.pick_node(pin.bg, action.x, action.y) then
			if key == STIRS then on_stirs_pressed() else on_map_pressed(key) end
			return
		end
	end
	for i=1,NODES do
		local tab = gui.get_node("tab_" .. i)
		if gui.is_enabled(tab) and gui.pick_node(tab, action.x, action.y) then
			on_map_pressed(map_of_node(i))
			return
		end
	end
end

local function on_pinch(touches)
	local a, b = touches[1], touches[2]
	local ax, ay = to_screen(a.screen_x, a.screen_y)
	local bx, by = to_screen(b.screen_x, b.screen_y)
	local mx, my = (ax + bx) / 2, (ay + by) / 2
	local d = math.max(1, math.sqrt((ax - bx) ^ 2 + (ay - by) ^ 2))
	if not pinch then
		local x = screen.w / 2 - view.x * view.zoom
		local y = screen.h / 2 - view.y * view.zoom
		pinch = { d = d, zoom = view.zoom, x = (mx - x) / view.zoom, y = (my - y) / view.zoom }
	end
	zoom_at(mx, my, pinch.zoom * d / pinch.d, pinch.x, pinch.y)
	if drag then drag.moved = true end
end

function on_input(self, action_id, action)
	if action_id == nil or not enabled or not view then return end
	if action_id == SCROLL_UP or action_id == SCROLL_DOWN then
		local sx, sy = to_screen(action.screen_x, action.screen_y)
		zoom_at(sx, sy, view.zoom * (action_id == SCROLL_UP and WHEEL_STEP or 1 / WHEEL_STEP))
		remember_view()
	elseif action_id == MULTITOUCH then
		local touches = {}
		for _,t in ipairs(action.touch or {}) do
			if not t.released then table.insert(touches, t) end
		end
		if #touches >= 2 then
			on_pinch(touches)
		elseif pinch then
			pinch = nil
			drag = nil
			remember_view()
		end
	else
		local sx, sy = to_screen(action.screen_x, action.screen_y)
		if action.pressed or not drag then
			drag = { sx = sx, sy = sy, x = view.x, y = view.y, moved = not action.pressed }
		elseif not pinch then
			if math.abs(sx - drag.sx) > TAP_SLOP or math.abs(sy - drag.sy) > TAP_SLOP then drag.moved = true end
			if drag.moved then
				view.x = drag.x - (sx - drag.sx) / view.zoom
				view.y = drag.y - (sy - drag.sy) / view.zoom
				apply_view()
			end
		end
		if action.released then
			if not drag.moved and not pinch then on_tap(action) end
			drag = nil
			remember_view()
		end
	end
end

--[[******************************************
MESSAGES
********************************************]]

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		print(string.upper(currentPage), "enabled", enabled)
		enabled = message.enabled
		gui.set_enabled(gui.get_node("root"), enabled)
		if enabled then
			msg.post("main:/overlay#header", "set_enabled", {enabled = false})
			msg.post(controller, "focus_kingdom", { status = true })
			-- Built on first open: during boot the page is not ready for it.
			if dev == nil then
				local ok, err = pcall(build_dev_menu)
				if not ok then print("KINGDOM dev menu", err) dev = false end
			end
			refresh_all()
			refresh_pins()
			restore_view()
			layout_dev_menu()
		end
		msg.post("main:/overlay#back", "set_enabled", {enabled = message.enabled})
	elseif message_id == hash("refresh_all") then
		refresh_all()
		if enabled then
			refresh_pins()
			layout_dev_menu()
		end
	end
end

function update()
	layout_screen()
	if enabled then refresh_pins() end
end
