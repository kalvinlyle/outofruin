local gooey 		= require('gooey.gooey')
local inspect 		= require('inspect')
local random 		= require('random/random')
local actions 		= require('actions')
local progress 		= require('progress/progress')
local saveload 		= require('saveload/saveload')
local defsave 		= require('defsave/defsave')
local loc 			= require("shared.locsheets")
local gui_extra_functions = require('gui_extra_functions/gui_extra_functions')

local productName = "OoR"
local currentPage = "header"
local Stats = {}
local Ranks = {}
local Quests = {}
local activeQuests = {}

local controller = "main:/menu#controller"
local enabled = false
local active = true
local buttonNode, labelNode
local nuggetNodes = {}
local shopalertPos = {}
local shopVisible = false
local cardAlertPos = 0

local focus = "roster"
local packTotal = 0

local questWidth
local questPos
local isAnimating = {}

-- The Start Chapter button sits where the quest cards are. Once the chapter's
-- rep target is met the leftover quests are optional, so they make way for
-- the button instead of drawing over it.
local function rankup_ready()
	return Stats.Rank ~= nil and Ranks[Stats.Rank] ~= nil and Stats.Rank < #Ranks and Stats.Rep >= Ranks[Stats.Rank].RepNeeded
end

--[[******************************************
					FUNCTIONS
********************************************]]

function init(self)
	questWidth = gui.get_size(gui.get_node("quests/item")).x / 2
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)
	gooey.acquire_input()
	gui_extra_functions.init()
	shopalertPos = gui.get_position(gui.get_node("shop/alert"))
	gui.set_render_order(10)
	isAnimating[1] = false
	isAnimating[2] = false
	isAnimating[3] = false

	gui.set_color(gui.get_node("rank/title"), actions.get_color("gold", 0.75))
	gui.set_color(gui.get_node("rank/text"), actions.get_color("gold", 0.75))
end

local function update_list(list)

	for i,item in pairs(list.items) do
		if item.data ~= nil then
			local questNode = item.nodes[hash("quest/bg")]
			local collectNode = item.nodes[hash("collect/bg")]
			local glintNode = item.nodes[hash("collect/glint")]
			local newNode = item.nodes[hash("new/bg")]
			local iconNode = item.nodes[hash("quest/icon")]
			local titleNode = item.nodes[hash("quest/text")]
			local detailNode = item.nodes[hash("quest/resource")]
			local progressBgNode = item.nodes[hash("quest/progress/bg")]
			local progressFillNode = item.nodes[hash("quest/progress/fill")]
			local totalNode = item.nodes[hash("quest/progress/text")]
			local prizeNode = item.nodes[hash("collect/prize/icon")]

			if item.data.Status == "Completed" then
				gui.set_enabled(collectNode, true)
				gui.set_enabled(questNode, false)
				gui.set_enabled(newNode, false)

				if gui.get_flipbook(glintNode) == hash("button_glint_static") then
					gui.play_flipbook(glintNode, "button_glint")
				end
				if item.data.Reward ~= nil then
					gui.set_texture(prizeNode, item.data.Reward.texture)
					gui.play_flipbook(prizeNode, item.data.Reward.flipbook) 
				end
			elseif item.data.Status == "New" then
				gui.set_enabled(collectNode, false)
				gui.set_enabled(questNode, false)
				gui.set_enabled(newNode, true)

				if not isAnimating[i] then
					isAnimating[i] = true
					gui.animate(newNode, "scale", vmath.vector3(1,1,1), gui.EASING_OUTBOUNCE, 1, (4-i)/9, nil, gui.PLAYBACK_LOOP_FORWARD)
				end

			else
				gui.set_enabled(collectNode, false)
				gui.set_enabled(questNode, true)
				gui.set_enabled(newNode, false)


				if item.data.Name ~= nil then
					gui.set_text(titleNode, string.upper(loc.get(item.data.Type)))
					gui.set_text(detailNode, string.upper(loc.get(item.data.Stat)))
				end

				if item.data.Icon ~= nil and item.data.Icon ~= "" then
					gui.set_texture(iconNode, item.data.Icon.texture)
					gui.play_flipbook(iconNode, item.data.Icon.flipbook)
				end

				if item.data.Total ~= nil and item.data.Goal ~= nil then 
					local progPercent = 0
					progPercent = math.max(0, math.floor(item.data.Total) / item.data.Goal)
					local progSize = gui.get_size(progressBgNode)
					gui.set_size(progressFillNode, vmath.vector3(progSize.x * progPercent, progSize.y, progSize.z))
					gui.set_text(totalNode, actions.display_number(math.floor(item.data.Total)) .. "/" .. actions.display_number(item.data.Goal))
				end
			end
		end
	end
end

function update()
	if enabled then

		local shopicon = gui.get_node("shop/icon")
		local shopalert = gui.get_node("shop/alert")
		local iconPos = gui.get_position(shopicon)
		local alertPos = gui.get_position(shopalert)
		if Stats.adReward ~= nil then
			if os.time(os.date("!*t")) >= Stats.adReward and iconPos.y == 0 then

				gui.set_position(shopicon, vmath.vector3(iconPos.x, 22,iconPos.z))
				gui.animate(shopicon, "position.y", 0.5, gui.EASING_OUTBOUNCE, 0.5)

				gui.set_position(shopalert, vmath.vector3(alertPos.x, shopalertPos.y + 20,alertPos.z))
				gui.animate(shopalert, "position.y", shopalertPos.y, gui.EASING_OUTBOUNCE, 0.5)

				gui.set_rotation(shopalert, vmath.vector3(0, 0, -15))
				gui.animate(shopalert, "rotation.z", 0, gui.EASING_OUTELASTIC, 0.5)
			end
			if iconPos.y == 0.5 then
				gui.animate(shopicon, "position.y", 0, gui.EASING_OUTBOUNCE, 1)
			end
		end
	end
end

local function cleanup()
	for n,nugget in ipairs(nuggetNodes) do
		if n > 1 then
			gui.delete_node(nuggetNodes[n])
			nuggetNodes[n] = nil
		end
	end
end

local function refresh_all()

	if defsave.get("Stats", "username") then 
		gui.set_text(gui.get_node("username/text"), defsave.get("Stats", "username"))
	end
	
	if actions.tablelength(defsave.loaded.Currency) > 0 then

		local currency = actions.clone(defsave.loaded.Currency.data)
		gui.set_text(gui.get_node("gold/total"), actions.display_number(currency.Gold))
		gui.set_text(gui.get_node("xp/total"), actions.display_number(currency.Xp))
		gui.set_text(gui.get_node("followers/total"), actions.display_number(defsave.get("Currency","Followers")) )
		
	end
	
	if actions.tablelength(defsave.loaded.Stats) > 0 then

		Stats = actions.clone(defsave.loaded.Stats.data)
		Ranks = actions.clone(defsave.loaded.Ranks.data)
		if Stats.Rank == #Ranks + 1 then
			gui.set_text(gui.get_node("rank/text"), loc.get("CHAPTER_MAX"))
		else
			gui.set_text(gui.get_node("rank/text"), Stats.Rank)
		end

		Quests = {}
		activeQuests = {}

		if Stats.Rank <= #Ranks then
			assert(Ranks[Stats.Rank].Quests, "quests missing")
			for q,quest in ipairs(Ranks[Stats.Rank].Quests) do
				table.insert(Quests, quest)
				if #activeQuests < Stats.questSlots and quest.Status ~= "Collected" then
					table.insert(activeQuests, 1, quest)

				end
			end
		end
		gui.set_enabled(gui.get_node("shop/bg"), Stats.Show.shopButton)
		gui.set_enabled(gui.get_node("mapbutton/bg"), Stats.Show.mapButton)
		gui.set_enabled(gui.get_node("cards/bg"), Stats.Show.cardsButton)
		gui.set_enabled(gui.get_node("discord/bg"), Stats.Show.discordButton)


		questPos = gui.get_position(gui.get_node("quests/root"))
		questScale = gui.get_scale(gui.get_node("quests/root"))

		gui.set_position(gui.get_node("quests/root"), vmath.vector3( questWidth * #activeQuests * questScale.x, questPos.y, questPos.z))
		update_list(gooey.horizontal_dynamic_list("quests", "quests/root", "quests/item", activeQuests, action_id, action, nil, function() end, function() end, true))


		local shopAlert = gui.get_node("shop/alert")
		if os.time(os.date("!*t")) >= Stats.adReward then
			gui.set_enabled(shopAlert, true)
		else
			gui.set_enabled(shopAlert, false)
		end


		local cardsAlertText = gui.get_node("cards/alert/text")
		local all_cards = {}
		all_cards = actions.tableConcat(all_cards, actions.load_all_savedata("Hero"))
		all_cards = actions.tableConcat(all_cards, actions.load_all_savedata("Henchmen"))
		all_cards = actions.tableConcat(all_cards, actions.load_all_savedata("Gear"))

		local numAlerts = 0
		for c,card in ipairs(all_cards) do
			card.Progress = card.Progress or 0
			if card.Progress >= 1 and card.Status == "Unlocked" then numAlerts = numAlerts + 1 end
		end

		gui.set_text(cardsAlertText, numAlerts)

		local cardsAlert = gui.get_node("cards/alert/bg")
		gui.set_enabled(cardsAlert, numAlerts > 0)
		if cardAlertPos == 0 then
			gui.set_color(cardsAlert, actions.get_color("red"))
			cardAlertPos = gui.get_position(cardsAlert)
		end
		
		gui.set_enabled(gui.get_node("rankup/bg"), false)
		gui.set_enabled(gui.get_node("portal/bg"), false)
		if Stats.Rank < #Ranks then
			gui.play_flipbook(gui.get_node("rankup/glint"), "button_glint")
			gui.set_text(gui.get_node("rankup/text"), string.upper(loc.get("CHAPTER_NEXT", Stats.Rank + 1)) )
			gui.set_enabled(gui.get_node("rankup/bg"), Stats.Rep >= Ranks[Stats.Rank].RepNeeded)
			local posNode = "rankup/bg"
			local pos = gui.get_position(gui.get_node(posNode))
			local rootNode = gui.get_node("rankup/root")
			local rootPos = gui.get_position(rootNode)
			local rootScale = gui.get_scale(rootNode)
			gui.set_position(rootNode, vmath.vector3(-pos.x/2*rootScale.x, rootPos.y, rootPos.z))
		end
		gui.set_enabled(gui.get_node("quests/root"), not rankup_ready())

		if Ranks[Stats.Rank] then
			if Stats.Rank >= #Ranks and Stats.Rank >= Ranks[Stats.Rank].RepNeeded then
				gui.set_text(gui.get_node("rank/text"), loc.get("CHAPTER_MAX"))
			else
				gui.set_text(gui.get_node("rank/text"), Stats.Rank)
			end
		else
			gui.set_text(gui.get_node("rank/text"), loc.get("CHAPTER_MAX"))
		end


		local rankQuests = 0
		if Stats.Rank <= #Ranks then rankQuests = Ranks[Stats.Rank].RepNeeded end
		if rankQuests == 0 then 
			gui.set_enabled(gui.get_node("rankprogress/back/bg"), false)
			gui.set_enabled(gui.get_node("rankprogress/bg"), false)
			gui.set_enabled(gui.get_node("rankprogress/text"), false)
		else
			gui.set_enabled(gui.get_node("rankprogress/back/bg"), true)
			gui.set_enabled(gui.get_node("rankprogress/bg"), true)
			gui.set_enabled(gui.get_node("rankprogress/text"), true)
			local rankProgText = gui.get_node("rankprogress/text")
			local rankProgWidth = gui.get_size(gui.get_node("rankprogress/back/bg")).x - ( gui.get_position(gui.get_node("rankprogress/bg")).x * 2 )
			local rankNuggetWidth = rankProgWidth / rankQuests
			local rankNuggetNode = gui.get_node("rankprogress/bg")
			local rankNuggetSize = gui.get_size(rankNuggetNode)
			gui.set_size(rankNuggetNode, vmath.vector3(rankNuggetWidth, rankNuggetSize.y, rankNuggetSize.z))
			local nuggetPos = gui.get_position(rankNuggetNode)
			local completedQuests = 0
			local collectedQuests = 0
			for q,quest in ipairs(Quests) do
				if quest.Status == "Completed" then completedQuests = completedQuests + 1 end
				if quest.Status == "Collected" then collectedQuests = collectedQuests + 1 end
			end

			local emptyColor 		= "progress_bar_section_darkgrey"
			local activeColor 		= "progress_bar_section_grey"
			local completedColor 	= "progress_bar_section_green"
			local collectedColor 	= "progress_bar_section_gold"

			for i=1,rankQuests do
				if i == 1 then
					nuggetNodes[i] = rankNuggetNode
				else
					if nuggetNodes[i] == nil then nuggetNodes[i] = gui.clone(rankNuggetNode) end
					gui.set_position(nuggetNodes[i], vmath.vector3(nuggetPos.x + rankNuggetWidth, nuggetPos.y, nuggetPos.z))
					gui.set_size(nuggetNodes[i], vmath.vector3(rankNuggetWidth, rankNuggetSize.y, rankNuggetSize.z))
				end
				nuggetPos = gui.get_position(nuggetNodes[i])
				
				if i <= collectedQuests then
					gui.play_flipbook(nuggetNodes[i], collectedColor)
				elseif i <= collectedQuests + completedQuests then
					gui.play_flipbook(nuggetNodes[i], completedColor)
				elseif i <= collectedQuests + #activeQuests then
					gui.play_flipbook(nuggetNodes[i], activeColor)
				else
					gui.play_flipbook(nuggetNodes[i], emptyColor)
				end
			end
			gui.set_text(rankProgText, Stats.Rep .. "/" .. rankQuests)
		end
	end
	
end

--[[******************************************
					INPUT
********************************************]]

local function update_button(button) end

local function on_pressed_rankup(item)
	cleanup()
	msg.post(controller, "popup_confirm", { title = loc.get("CONFIRM_CHAPTER_CLOSE_TITLE"), text = loc.get("CONFIRM_CHAPTER_CLOSE_MESSAGE"), msgpost =  { message_id = "show_sellitems",  message = { portal = false } } } )
end

local function on_pressed_portal(item)
	if defsave.get("Currency", "PortalScrolls") > 0 then
		cleanup()
		msg.post(controller, "use_portalscroll" )
	elseif defsave.get("Currency", "Gold") > defsave.get("Stats", "portalScrollCost") then
		cleanup()
		msg.post(controller, "buy_portalscroll", { gold = -defsave.get("Stats", "portalScrollCost"), amount = 1 })
		msg.post(controller, "use_portalscroll" )
	else
		msg.post(controller, "show_shop")
	end
end

local function on_pressed_quest(item)
	if item.data[item.selected_item].Status == "New" and item.data[item.selected_item].Story_Int ~= nil then

		msg.post(controller, "popup_questOpen", { id = item.data[item.selected_item].id })
	elseif item.data[item.selected_item].Status == "New" and item.data[item.selected_item].Story_Int == nil then
		msg.post(controller, "read_quest", { rank = Stats.Rank, id = item.data[item.selected_item].id })
	elseif item.data[item.selected_item].Status == "Completed" and item.data[item.selected_item].Story_Ext ~= nil then
		msg.post(controller, "popup_questClose", {id = item.data[item.selected_item].id})
	elseif item.data[item.selected_item].Status == "Completed" and item.data[item.selected_item].Story_Ext == nil then
		msg.post(controller, "popup_questCollect", {id = item.data[item.selected_item].id})
		refresh_all()
	end
end

local function on_pressed_footerbutton(item)
	if focus ~= item then
		msg.post(controller, "show_" .. item, { focus = item })
	else
		msg.post(controller, "show_dungeonmine")
	end
end

local function on_pressed_footersettings(button) 		on_pressed_footerbutton("settings") 		end
local function on_pressed_footershop(button) 			on_pressed_footerbutton("shop") 			end
local function on_pressed_footercards(button) 			on_pressed_footerbutton("cards") 			end
local function on_pressed_footerdiscord(button) 		msg.post(controller, "social_discord") 		end
local function on_pressed_footerquest(button) 			msg.post(controller, "show_kingdom")		end

function on_input(self, action_id, action)
	if action_id ~= nil and enabled and active then

		if Stats.Rank <= #Ranks then
			if Stats.Rep >= Ranks[Stats.Rank].RepNeeded then
				gooey.button("rankup/bg", action_id, action, on_pressed_rankup, update_button)
				gooey.button("portal/bg", action_id, action, on_pressed_portal, update_button)
			end
		end

		if not rankup_ready() then
			gooey.horizontal_dynamic_list("quests", "quests/root", "quests/item", activeQuests, action_id, action, nil, on_pressed_quest, update_list)
		end

		gooey.button("discord/bg", action_id, action, on_pressed_footerdiscord, update_button)
		gooey.button("cards/bg", action_id, action, on_pressed_footercards, update_button)
		gooey.button("mapbutton/bg", action_id, action, on_pressed_footerquest, update_button)
		gooey.button("shop/bg", action_id, action, on_pressed_footershop, update_button)
		gooey.button("settings/bg", action_id, action, on_pressed_footersettings, update_button)

	end
end

--[[******************************************
					MESSAGES
********************************************]]

local function set_particletargets()
	local target_xp_pos = gui.get_screen_position(gui.get_node("xp/icon"))
	print(target_xp_pos)
	local target_gold_pos = gui.get_screen_position(gui.get_node("gold/icon"))
	local target_followers_pos = gui.get_screen_position(gui.get_node("followers/icon"))
	msg.post(controller, "set_particletarget", { name = "target_xp", pos = target_xp_pos } )
	msg.post(controller, "set_particletarget", { name = "target_gold", pos = target_gold_pos } )
	msg.post(controller, "set_particletarget", { name = "target_followers", pos = target_followers_pos } )
end

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		enabled = message.enabled
		print(string.upper(currentPage), "enabled", enabled)
		gui.set_enabled(gui.get_node("root"), enabled)
		active = true
		if enabled then
			if message.focus ~= nil then focus = message.focus end
			if defsave then refresh_all() end
			set_particletargets()
		end
	elseif message_id == hash("get_particletargets") then
		set_particletargets()
	elseif message_id == hash("set_active") then
		active = message.active
		if enabled and defsave then refresh_all() end
	elseif message_id == hash("set_platform") then
		gui.set_text(gui.get_node("platform/text"), "platform: " .. message.platform)
	elseif message_id == hash("update_fps") then
		gui.set_text(gui.get_node("fps/text"), "fps: " .. message.text)
		if enabled and defsave then refresh_all() end
	elseif message_id == hash("refresh_all") then
		if enabled and defsave then refresh_all() end
	elseif message_id == hash("window_dimensions") then
		gui_extra_functions.update_coef(message.width, message.height)
		for t,target in pairs(targets) do
			targets[t] = gui.get_position(gui.get_node(t))
		end
		set_particletargets()
	elseif message_id == hash("window_resized") then
		msg.post("@render:", "get_dimensions", { callback = "main:/overlay#header" })
		set_particletargets()
	elseif message_id == hash("layout_changed") then
		gooey.horizontal_dynamic_list("quests", "quests/root", "quests/item", activeQuests, action_id, action).scroll_to(0, 0)
		set_particletargets()
	end
end
