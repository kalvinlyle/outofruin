local gooey 		= require('gooey.gooey')
local inspect 		= require('inspect')
local actions 		= require('actions')
local random 		= require('random/random')
local progress 		= require('progress/progress')
local defsave 		= require('defsave/defsave')
local loc 			= require("shared.locsheets")

local productName = "OoR"
local currentPage = "openpack"

local controller	= "main:/menu#controller"
local enabled = false
local active = true

local pack = {}
local pack_id = 0 
local items = {}
local henchmen_data = {}
local gear_data = {}
local hero_data = {}
local xpcount = 1
local goldcount = 1

local minicards = {}
local summaryPos = {}

local henchmencount = 0
local gearcount = 0
local herocount = 0

local itemcount = 1
local resourcecount = 1
local state = "closed"
local openinit = 0
local timer = 0
local chestpos = 0
local complete_purchase_callback = "dungeonmine"

--[[******************************************
					FUNCTIONS
********************************************]]

function init(self)
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)
	
	gui.set_enabled(gui.get_node("card/bg"), false)
	gui.set_enabled(gui.get_node("loot/shine/bg"), false)
	gui.set_enabled(gui.get_node("loot/treasure/bg"), false)
	chestpos = gui.get_position(gui.get_node("loot/bg"))
	gui.set_render_order(5)

	summaryPos = gui.get_position(gui.get_node("summary/bg"))
end

local function animatetile(node)
	local pos = gui.get_position(node)
	local animDuration = 0.5
	local posOffset = -250
	local scaleOffset = 0.75

	gui.set_enabled(node, true)
	gui.set_scale(node, vmath.vector3(scaleOffset, scaleOffset, scaleOffset))
	gui.set_position(node, vmath.vector3(pos.x, posOffset, pos.z))
	gui.animate(node, "position.y", 0, go.EASING_OUTELASTIC, animDuration, gui.PLAYBACK_ONCE_FORWARD)
	gui.animate(node, gui.PROP_SCALE, vmath.vector3(1, 1, 1), go.EASING_OUTELASTIC, animDuration, gui.PLAYBACK_ONCE_FORWARD)
end

local function set_card(card, num, prefix)
	local color = {
		Common = 		"tinyfancybutton_darkgrey",
		Wild = 			"tinyfancybutton_brown",
		Rare = 			"tinyfancybutton_green",
		Epic = 			"tinyfancybutton_blue",
		Legendary = 	"tinyfancybutton_purple",
		Exotic = 		"tinyfancybutton_orange",
		Gold = 			"tinyfancybutton_gold",
		Xp = 			"tinyfancybutton_green"
	}
	card.Name = card.Name or ""
	card.Description = card.Description or ""
	gui.set_text(gui.get_node(prefix .. "/count/text"), "x" .. actions.display_number(num))
	if card.Portrait ~= nil then
		gui.set_texture(gui.get_node(prefix .. "/image"), card.Portrait.texture)
		gui.play_flipbook(gui.get_node(prefix .. "/image"), card.Portrait.flipbook)
		-- Card art fills its window, as on every other card screen. Square
		-- reward icons below keep their frame size so the star and the bag
		-- are not cropped.
		actions.fill_card_window(gui.get_node(prefix .. "/image"), gui.get_node(prefix .. "/image/stencil"))
	elseif card.Icon ~= nil then
		-- the node may still hold the size a portrait was stretched to
		gui.set_size_mode(gui.get_node(prefix .. "/image"), gui.SIZE_MODE_AUTO)
		gui.set_texture(gui.get_node(prefix .. "/image"), card.Icon.texture)
		gui.play_flipbook(gui.get_node(prefix .. "/image"), card.Icon.flipbook)
	end
	gui.play_flipbook(gui.get_node(prefix .. "/panel/bg"), color[card.Rarity])
end

local function create_minicard(card, num, prefix)
	set_card(card, num, prefix)
	if minicards == nil then minicards = {} end
	table.insert(minicards, gui.clone_tree(gui.get_node("minicard/panel/bg")))
end

local function cleanup()
	for c,card in ipairs(minicards) do
		gui.delete_node(minicards[c][hash("minicard/panel/bg")])
		minicards[c] = nil
	end
	minicards = {}
end

--[[ Mother Mabb, the patron for card packs (gdd/heroes-roster.md), pops in at
the edge of the screen and flicks her own picks onto the pile after the
pack's cards are dealt. ]]
local mabb_picks = {}
local mabb_node = nil

local function show_mabb()
	if not mabb_node then
		mabb_node = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(220, 220, 0))
		gui.set_texture(mabb_node, "main")
		gui.play_flipbook(mabb_node, "patron_mothermabb")
		gui.set_parent(mabb_node, gui.get_node("root"))
	end
	local card = gui.get_position(gui.get_node("card/bg"))
	gui.set_enabled(mabb_node, true)
	gui.set_position(mabb_node, vmath.vector3(card.x - 600, card.y + 260, 0))
	gui.animate(mabb_node, "position", vmath.vector3(card.x - 230, card.y + 260, 0), gui.EASING_OUTBACK, 0.35)
end

local function hide_mabb()
	if mabb_node then gui.set_enabled(mabb_node, false) end
end

local function close_screen()
	cardcount = 1
	resourcecount = 1
	itemcount = 1
	cleanup()
	hide_mabb()
	state = "closed"
	gui.play_flipbook(gui.get_node("loot/bg"), pack.container .. "_closed")
	gui.set_enabled(gui.get_node("loot/shine/bg"), false)
	gui.set_enabled(gui.get_node("loot/treasure/bg"), false)
	gui.set_enabled(gui.get_node("card/bg"), false)
	msg.post(controller, "close_pack", { pack_id = pack_id })
	msg.post(controller, "show_" .. complete_purchase_callback)
end

local function open_pack()
	gui.set_enabled(gui.get_node("card/bg"), false)
	gui.set_enabled(gui.get_node("summary/bg"), false)
	
	if state == "closed" then
		state = "opening"
		local min = -0.05
		local max = 0.05
		local values = {
			min, min, min, 
			max, max, max
		}
		local vec = vmath.vector(values)
		local node = gui.get_node("loot/bg")

		gui.animate(node, "position.x", 100, vec, 0.1, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
	elseif state == "open" then
		gui.set_enabled(gui.get_node("loot/shine/bg"), false)
		gui.set_enabled(gui.get_node("loot/treasure/bg"), true)
		-- Each step counts its card off before drawing it, so a card the
		-- screen cannot show (its data or art gone since the pack was saved)
		-- is skipped instead of failing on every tap. The pack is otherwise
		-- never closed, and the dungeon reopens it on every visit.
		local reveal = nil
		if xpcount < (pack.xp or 0) then
			xpcount = pack.xp
			reveal = function()
				local card = {}
				card.Rarity = "Xp"
				card.Icon = { texture = "reward_icons", flipbook = "reward_xp_icon" }
				gui.set_text(gui.get_node("card/name"), string.upper(loc.get("COLLECT_XP")) )
				gui.set_text(gui.get_node("card/text"), "")
				set_card(card, pack.xp, "card")
				create_minicard(card, pack.xp, "minicard")
			end
		elseif goldcount < (pack.gold or 0) then
			goldcount = pack.gold
			reveal = function()
				local card = {}
				card.Rarity = "Gold"
				card.Icon = { texture = "reward_icons", flipbook = "reward_gold_icon" }
				gui.set_text(gui.get_node("card/name"), string.upper(loc.get("COLLECT_GOLD")))
				gui.set_text(gui.get_node("card/text"), "")
				set_card(card, pack.gold, "card")
				create_minicard(card, pack.gold, "minicard")
			end
		elseif resourcecount <= #(pack.resources or {}) then
			local resource = pack.resources[resourcecount]
			resourcecount = resourcecount + 1
			-- A saved pack carries the icon it was drawn with; show today's.
			local live = resource.Stat and defsave.loaded.Resources.data[resource.Stat]
			if live then resource.Icon = live.Icon end
			reveal = function()
				gui.play_flipbook(gui.get_node("card/bg"), "tinyfancypanel_darkbrown")
				gui.set_text(gui.get_node("card/name"), loc.get(resource.Name) )
				gui.set_text(gui.get_node("card/text"), loc.get(resource.Description) )
				set_card(resource, resource.amount, "card")
				create_minicard(resource, resource.amount, "minicard")
			end
		elseif #mabb_picks > 0 then
			local pick = table.remove(mabb_picks, 1)
			local data = ({ gear = gear_data, henchmen = henchmen_data, hero = hero_data })[pick.type]
			reveal = function()
				local card = data[pick.id]
				gui.play_flipbook(gui.get_node("card/bg"), "tinyfancypanel_purple")
				gui.set_text(gui.get_node("card/name"), loc.get("HERO_BONUS_MABBSPICK") .. ": " .. loc.get(card.Name) )
				gui.set_text(gui.get_node("card/text"), loc.get(card.Description) )
				set_card(card, pick.amount, "card")
				create_minicard(card, pick.amount, "minicard")
				show_mabb()
			end
		elseif gearcount > 0 or henchmencount > 0 or herocount > 0 then
			local packcard, data
			if gearcount > 0 then
				packcard, data = pack.cards.gear[gearcount], gear_data
				gearcount = gearcount - 1
			elseif henchmencount > 0 then
				packcard, data = pack.cards.henchmen[henchmencount], henchmen_data
				henchmencount = henchmencount - 1
			else
				packcard, data = pack.cards.hero[herocount], hero_data
				herocount = herocount - 1
			end
			reveal = function()
				local card = data[packcard.id]
				gui.play_flipbook(gui.get_node("card/bg"), "tinyfancypanel_brown")
				gui.set_text(gui.get_node("card/name"), loc.get(card.Name) )
				gui.set_text(gui.get_node("card/text"), loc.get(card.Description) )
				set_card(card, packcard.amount, "card")
				create_minicard(card, packcard.amount, "minicard")
			end
		end
		if reveal then
			local ok, err = pcall(reveal)
			if ok then
				animatetile(gui.get_node("card/bg"))
			else
				print(string.upper(currentPage), "skipped a card", err)
				gui.set_enabled(gui.get_node("card/bg"), false)
				open_pack()
			end
		else
			gui.set_enabled(gui.get_node("card/bg"), false)
			gui.set_enabled(gui.get_node("summary/bg"), false)
			gui.set_enabled(gui.get_node("minicard/panel/bg"), false)

			if #minicards > 1 then
				gui.set_enabled(gui.get_node("summary/bg"), true)
				local pos = gui.get_position(gui.get_node("minicard/panel/bg"))
				local scale = gui.get_scale(gui.get_node("minicard/panel/bg"))
				local size = gui.get_size(gui.get_node("minicard/panel/bg"))
				local row = 0
				local column = 0
				local padding = 5
				local width = (size.x * scale.x) + padding
				local height = (size.y * scale.y) + padding
				for m,minicard in ipairs(minicards) do
					gui.set_enabled(minicard[hash("minicard/panel/bg")], true)
					gui.set_position(minicard[hash("minicard/panel/bg")], vmath.vector3( pos.x + (column * width), pos.y + (-row * height), pos.z))
					column = column + 1
					if column >= 3 then column = 0; row = row + 1 end
				end
				gui.set_position(gui.get_node("summary/bg"), vmath.vector3(summaryPos.x - ( math.min(3,#minicards) * width/2), summaryPos.y + ( math.ceil(#minicards/3) * height/2), summaryPos.z))
			else
				close_screen()
			end
			state = "done"
		end
	elseif state == "done" then
		close_screen()
	end
end

function update(self)

	if enabled and state ~= "open" then
		if state ~= "closed" and os.clock() > openinit + timer then
			if state == "shine" then
				state = "open"
				openinit = os.clock()
				timer = 0.25
				open_pack()
			end
			if state == "opening" then
				state = "shine"
				openinit = os.clock()
				timer = 0.05
			end
		end
		if state == "shine" then

			local node = gui.get_node("loot/bg")
			gui.cancel_animation(node, "position.x")
			gui.set_position(gui.get_node("loot/bg"), chestpos)
			gui.play_flipbook(gui.get_node("loot/bg"), pack.container .. "_open")
			gui.set_enabled(gui.get_node("loot/shine/bg"), true)
		end
		if state == "open" then
			gui.set_enabled(gui.get_node("loot/shine/bg"), false)
			gui.set_enabled(gui.get_node("loot/treasure/bg"), true)
		end
	end
end

--[[******************************************
					INPUT
********************************************]]

function on_input(self, action_id, action)
	cardcount = cardcount
	if action_id ~= nil and enabled then
		if action.pressed and os.clock() > openinit + timer then
			if state ~= "closed" then
				openinit = os.clock()
				timer = 0.25
			end
			open_pack()
			gui.set_enabled(gui.get_node("loot/button/text"), false)
		end
	end
end

--[[******************************************
					MESSAGES
********************************************]]

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		enabled = message.enabled
		print(string.upper(currentPage), "enabled", enabled)
		gui.set_enabled(gui.get_node("root"), enabled)
		msg.post("main:/background#background", "set_enabled", {enabled = enabled})
		if enabled then
			complete_purchase_callback = message.complete_purchase_callback or "dungeonmine"
			gui.set_enabled(gui.get_node("loot/button/text"), true)
			local packs = actions.clone(defsave.loaded.Loot.data.Packs)
			henchmen_data = actions.clone(defsave.loaded.Henchmen.data)
			gear_data = actions.clone(defsave.loaded.Gear.data)
			hero_data = actions.clone(defsave.loaded.Hero.data)
			pack_id = message.pack_id
			pack = packs[pack_id]
			if pack == nil then msg.post(controller, "show_previous") return end
			pack.cards = pack.cards or {}
			items = actions.clone(defsave.loaded.Loot.data.Items)
			xpcount = 1
			goldcount = 1
			itemcount = 1
			if pack.cards.henchmen then henchmencount = #pack.cards.henchmen end
			if pack.cards.gear then gearcount = #pack.cards.gear end
			if pack.cards.hero then herocount = #pack.cards.hero end
			mabb_picks = {}
			for _,cards in pairs(pack.mabb or {}) do
				for _,card in ipairs(cards) do table.insert(mabb_picks, card) end
			end
			gui.play_flipbook(gui.get_node("loot/bg"), pack.container .. "_closed")
			openinit = os.clock()
			timer = 0.25
			state = "closed"
			open_pack()
		end
	end
end
