-- Where the level list was left, per dungeon, as a 0-1 fraction of its scroll
-- range. Leaving the page and coming back used to drop the player at the top.
local scroll_memory = {}

-- Enemy rows just cleared, kept on screen until their last kill has played.
local enemy_dying = {}
local ENEMY_DYING_TIME = 2.4

local function scroll_key()
	return map_id .. "-" .. dungeon_id
end

local function remember_scroll(list)
	scroll_memory[scroll_key()] = list.scroll.y
end

local function restore_scroll()
	gooey.dynamic_list("dungeon", "dungeon/stencil", "level/root", level_list, nil, nil, LEVEL_LIST_CONFIG).scroll_to(0, scroll_memory[scroll_key()] or 0)
end

--[[******************************************
					SCREEN FIT
********************************************]]

--[[ Same deal as the header: the scene is drawn for 750x1334, the root goes
on a plain uniform fit, and the three bands of this screen - tab strip, map,
dungeon list - are then placed against the real screen edges. A taller window
mostly feeds the list, which is what the extra room is worth; a wider one
widens the bands, but never the map art, which stays at design scale so it
reads at the same size as the cards and panels beside it. ]]
local DESIGN_W = 750
local DESIGN_H = 1334

local HEADER_DEPTH = 255.5	-- how far the top bar reaches down from the top edge
local FOOTER_TOP = 105		-- underside of the content, over the bottom bar
local TITLE_DROP = 81.5		-- tab strip, below the top bar
local MAP_DROP = 73.5		-- map, below the top bar
local MAP_H = 325
local MAP_SHARE = 0.25		-- of the height a tall window adds, the rest is list
local ROSTER_RISE = 21		-- hero card panel, above the map's bottom edge
local LIST_BOTTOM = 80		-- the list runs a little under the bottom bar
local TAB_LEFT = -375		-- first tab, from the middle of a 750 wide strip
local EVENT_BAR_H = 52		-- the header's event bar, on event maps only

local screen = { w = 0, h = 0 }

local function screen_size()
	local ww, wh = window.get_size()
	local scale = math.min(ww / DESIGN_W, wh / DESIGN_H)
	return ww / scale, wh / scale
end

local set_map_position

local function layout_screen()
	local w, h = screen_size()
	-- On event maps the header carries the event's bar under its top panel,
	-- so everything here starts lower and the layout runs again when the map
	-- changes.
	local on_event = map_id ~= 1
	if math.abs(w - screen.w) < 1 and math.abs(h - screen.h) < 1 and screen.event == on_event then return end
	screen.w, screen.h, screen.event = w, h, on_event

	local root = gui.get_node("root")
	gui.set_adjust_mode(root, gui.ADJUST_FIT)
	gui.set_xanchor(root, gui.ANCHOR_NONE)
	gui.set_yanchor(root, gui.ANCHOR_NONE)

	local clip = gui.get_node("menu/clip")
	gui.set_position(clip, vmath.vector3((DESIGN_W - w) / 2, (DESIGN_H - h) / 2, 0))
	gui.set_size(clip, vmath.vector3(w, h, 0))

	local top = h - HEADER_DEPTH - (on_event and EVENT_BAR_H or 0)
	local map_h = MAP_H + math.max(0, h - DESIGN_H) * MAP_SHARE

	local title = gui.get_node("panel_title/bg")
	gui.set_position(title, vmath.vector3(w / 2, top - TITLE_DROP, 0))
	gui.set_size(title, vmath.vector3(w, 25, 0))
	for i = 1, 5 do
		local tab = gui.get_node("dungeon/tab/" .. i)
		local p = gui.get_position(tab)
		p.x = -w / 2 + (i - 1) * 80
		gui.set_position(tab, p)
	end

	local map_y = top - MAP_DROP - map_h
	local map = gui.get_node("map/stencil")
	local bg = gui.get_node("map/bg")
	-- The band runs the full width of the screen. The map art is one drawing, so
	-- on a screen wider than it it is scaled up to cover rather than stretched.
	local cover = math.max(1, w / gui.get_size(bg).x)
	gui.set_scale(bg, vmath.vector3(cover, cover, 1))
	gui.set_position(map, vmath.vector3(w / 2, map_y, 0))
	gui.set_size(map, vmath.vector3(w, map_h, 0))
	if map_data[dungeon_id] then set_map_position(0) end

	-- The hero cards ride the map's bottom edge in the scene, centred on the
	-- design-height band; keep them on the middle of the band as it grows.
	local roster = gui.get_node("panel_roster/bg")
	local rp = gui.get_position(roster)
	rp.y = ROSTER_RISE + (map_h - MAP_H) / 2
	gui.set_position(roster, rp)
	if rosterPosition.y then rosterPosition.y = rp.y end

	local list_top = map_y
	screen.list_top = list_top
	for _, id in ipairs({"dungeon/root", "dungeon/stencil"}) do
		local node = gui.get_node(id)
		gui.set_size(node, vmath.vector3(w, list_top - LIST_BOTTOM, 0))
	end
	local list = gui.get_node("dungeon/root")
	gui.set_position(list, vmath.vector3(w / 2, list_top, 0))
end

