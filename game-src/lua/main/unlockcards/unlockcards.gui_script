local gooey 		= require('gooey.gooey')
local inspect 		= require('inspect')
local actions 		= require('actions')
local saveload 		= require('saveload/saveload')
local defsave 		= require('defsave/defsave')
local loc 			= require("shared.locsheets")

local productName = "OoR"
local currentPage = "levelUp_popup"
local controller = "main:/menu#controller"
local enabled = false

local henchmen_data = {}
local henchmen_list = {}

local hero_data = {}
local hero_list = {}

local gear_data = {}
local gear_list = {}

local popupNode = {}
local lockNode = {}
local shadowNode = {}

local lockPos = {}
local shadowColor = vmath.vector4(1,1,1,1)

local paused = false
local timer = 0
local click = false

--[[******************************************
					SCREEN FIT
********************************************]]

--[[ The scene is drawn for a 750x1334 phone and Defold fits that rectangle
into the window, so on any other shape the room left over turns into margin
and anything full bleed stops reaching the edges. The root goes on a plain
uniform fit, and the parts that have to touch an edge are placed against the
real one. The long version of this note is in main/nav/header.gui_script. ]]
local DESIGN_W = 750
local DESIGN_H = 1334
local HEADER_DEPTH = 255.5	-- underside of the header's top bar, from the top edge
local FOOTER_TOP = 105		-- top of the header's bottom bar, from the bottom edge

local screen = { w = 0, h = 0 }

-- The screen in design units, or nil if it has not changed since last call.
local function screen_changed()
	local ww, wh = window.get_size()
	local scale = math.min(ww / DESIGN_W, wh / DESIGN_H)
	local w, h = ww / scale, wh / scale
	if math.abs(w - screen.w) < 1 and math.abs(h - screen.h) < 1 then return nil end
	screen.w, screen.h = w, h
	local root = gui.get_node("root")
	gui.set_adjust_mode(root, gui.ADJUST_FIT)
	gui.set_xanchor(root, gui.ANCHOR_NONE)
	gui.set_yanchor(root, gui.ANCHOR_NONE)
	return w, h
end

local function screen_left()	return (DESIGN_W - screen.w) / 2 end
local function screen_bottom()	return (DESIGN_H - screen.h) / 2 end
local function screen_top()		return screen_bottom() + screen.h end
local function content_top()	return screen_top() - HEADER_DEPTH end
local function content_bottom()	return screen_bottom() + FOOTER_TOP end

local function place(id, x, y)
	local node = gui.get_node(id)
	local p = gui.get_position(node)
	gui.set_position(node, vmath.vector3(x or p.x, y or p.y, p.z))
	return node
end

local function resize(id, w, h)
	local node = gui.get_node(id)
	local s = gui.get_size(node)
	gui.set_size(node, vmath.vector3(w or s.x, h or s.y, s.z))
	return node
end

local function layout_screen()
	local w, h = screen_changed()
	if not w then return end
	place("root/center", nil, screen_bottom() + h / 2)
end

function init(self)
	layout_screen()
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)
	gui.set_render_order(15)
	gooey.acquire_input()

	popupNode = gui.get_node("unlockcards/bg")
	lockNode = gui.get_node("card/lock")
	shadowNode = gui.get_node("card/shadow")
	
	lockPos =  gui.get_position(lockNode)
	shadowColor = gui.get_color(shadowNode)
end

local function show_card(list, data)

	local color = {
		Common = 		"tinyfancybutton_darkgrey",
		Wild = 			"tinyfancybutton_brown",
		Rare = 			"tinyfancybutton_green",
		Epic = 			"tinyfancybutton_blue",
		Legendary = 	"tinyfancybutton_purple",
		Exotic = 		"tinyfancybutton_orange"
	}
	
	if #list > 0 then


		paused = true
		timer = os.clock() + 0.5


		local Card = data[list[1]]
		

		if Card.Portrait then 
			gui.set_texture(gui.get_node("card/image"), Card.Portrait.texture)
			gui.play_flipbook(gui.get_node("card/image"), Card.Portrait.flipbook)
		elseif Card.Icon then 
			gui.set_texture(gui.get_node("card/image"), Card.Icon.texture)
			gui.play_flipbook(gui.get_node("card/image"), Card.Icon.flipbook)
		end
		actions.fill_card_window(gui.get_node("card/image"), gui.get_node("card/portrait/stencil"))
		gui.set_text(gui.get_node("card/name"), loc.get(Card.Name))
		gui.set_text(gui.get_node("card/text"), loc.get(Card.Description))

		gui.play_flipbook(gui.get_node("card/panel/bg"), color[Card.Rarity])


		gui.set_scale(popupNode, vmath.vector3(0.9, 0.9, 0.9))
		gui.animate(popupNode, gui.PROP_SCALE, vmath.vector3(1, 1, 1), go.EASING_OUTELASTIC, 0.75, gui.PLAYBACK_ONCE_FORWARD)


		gui.play_flipbook(lockNode, "Locked")
		gui.set_position(lockNode, lockPos)
		gui.play_flipbook(lockNode, "Unlocked")
		gui.animate(lockNode, gui.PROP_POSITION, vmath.vector3(0, -500, 0), go.EASING_INBACK, 0.75, gui.PLAYBACK_ONCE_FORWARD)


		gui.set_color(shadowNode, shadowColor)
		gui.animate(shadowNode, gui.PROP_COLOR, vmath.vector4(0, 0, 0, 0), go.EASING_LINEAR, 0.25, gui.PLAYBACK_ONCE_FORWARD)


		table.remove(list, 1)

	end

	return list

end

local function next()
	if #henchmen_list > 0 then
		henchmen_list = show_card(henchmen_list, henchmen_data)
	elseif #gear_list > 0 then
		gear_list = show_card(gear_list, gear_data)
	elseif #hero_list > 0 then
		hero_list = show_card(hero_list, hero_data)
	else
		msg.post(controller, "show_dungeonmine")
	end
end

function update()
	layout_screen()
	if enabled then

		if paused and os.clock() > timer then
			paused = false
		end
		if not paused and click then
			next()
			click = false
		end
	end
end

local function refresh_all()

	henchmen_data = actions.clone(defsave.loaded.Henchmen.data)
	hero_data = actions.clone(defsave.loaded.Hero.data)
	gear_data = actions.clone(defsave.loaded.Gear.data)
end

--[[******************************************
INPUT
********************************************]]

function on_input(self, action_id, action)
	if action_id ~= nil and enabled then
		if action_id == hash("touch") and action.pressed then
			click = true
		end
	end
end

--[[******************************************
MESSAGES
********************************************]]

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		enabled = message.enabled
		print(string.upper(currentPage), "enabled", enabled)
		gui.set_enabled(gui.get_node("root"), enabled)
		msg.post("main:/background#background", "set_enabled", { enabled = enabled, effect = { type = "stream", texture = "backgrounds", flipbook = "rankup" } })
		if enabled then
			if message.henchmen_list then 
				for c,card in pairs(message.henchmen_list) do
					table.insert(henchmen_list, card)
				end
			end
			if message.hero_list then 
				for c,card in pairs(message.hero_list) do
					table.insert(hero_list, card)
				end
			end
			if message.gear_list then 
				for c,card in pairs(message.gear_list) do
					table.insert(gear_list, card)
				end
			end
			refresh_all()
			click = true
		end
	elseif message_id == hash("refresh_all") then
		refresh_all()
	end
end
