local gooey 		= require('gooey.gooey')
local inspect 		= require('inspect')
local actions 		= require('actions')
local saveload 		= require('saveload/saveload')
local defsave 		= require('defsave/defsave')
local loc 			= require("shared.locsheets")

local productName = "OoR"
local currentPage = "sellitems"
local controller = "main:/menu#controller"
local enabled = false
local portal = false
local haul = nil		-- the event haul being sold, or nil on the chapter's sell screen

local resource_data = {}
local resource_nodes = {}
local inventory = {}

local itemNode = {}
local itemSize = {}
local invNode = {}
local invPos = {}
local invSize = {}
local framePos = {}
local shadowColor = {}

local invPadding = 0
local numRows = 0
local numCols = 0

local Gold = 0
local bonusGold = 0
local invValue = 0

--[[******************************************
					SCREEN FIT
********************************************]]

--[[ The scene is drawn for a 750x1334 phone and Defold fits that rectangle
into the window, so on any other shape the room left over turns into margin
and anything full bleed stops reaching the edges. The root goes on a plain
uniform fit, and the parts that have to touch an edge are placed against the
real one. The long version of this note is in main/nav/header.gui_script. ]]
local DESIGN_W = 750
local DESIGN_H = 1334
local HEADER_DEPTH = 255.5	-- underside of the header's top bar, from the top edge
local FOOTER_TOP = 105		-- top of the header's bottom bar, from the bottom edge

local screen = { w = 0, h = 0 }

-- The screen in design units, or nil if it has not changed since last call.
local function screen_changed()
	local ww, wh = window.get_size()
	local scale = math.min(ww / DESIGN_W, wh / DESIGN_H)
	local w, h = ww / scale, wh / scale
	if math.abs(w - screen.w) < 1 and math.abs(h - screen.h) < 1 then return nil end
	screen.w, screen.h = w, h
	local root = gui.get_node("root")
	gui.set_adjust_mode(root, gui.ADJUST_FIT)
	gui.set_xanchor(root, gui.ANCHOR_NONE)
	gui.set_yanchor(root, gui.ANCHOR_NONE)
	return w, h
end

local function screen_left()	return (DESIGN_W - screen.w) / 2 end
local function screen_bottom()	return (DESIGN_H - screen.h) / 2 end
local function screen_top()		return screen_bottom() + screen.h end
local function content_top()	return screen_top() - HEADER_DEPTH end
local function content_bottom()	return screen_bottom() + FOOTER_TOP end

local function place(id, x, y)
	local node = gui.get_node(id)
	local p = gui.get_position(node)
	gui.set_position(node, vmath.vector3(x or p.x, y or p.y, p.z))
	return node
end

local function resize(id, w, h)
	local node = gui.get_node(id)
	local s = gui.get_size(node)
	gui.set_size(node, vmath.vector3(w or s.x, h or s.y, s.z))
	return node
end

local function layout_screen()
	local w, h = screen_changed()
	if not w then return end
	place("background", screen_left(), screen_bottom())
	resize("background", w, h)

	-- Currency strip under the header, inventory filling down to the footer.
	place("currency/bg", nil, screen_top() - 89)
	local frame = screen_top() - 114
	place("inventory/frame", screen_left() + 25, frame)
	resize("inventory/frame", w - 50, frame - (content_bottom() + 40))
	local inner = screen_top() - 137
	place("inventory/bg", screen_left() + 50, inner)
	resize("inventory/bg", w - 100, inner - (content_bottom() + 20))

	place("panel_bottom/bg", nil, screen_bottom() - 20)
	resize("panel_bottom/bg", w + 150, nil)
end

function init(self)
	layout_screen()
	print(string.upper(currentPage), "init", enabled)
	gui.set_enabled(gui.get_node("root"), enabled)
	itemNode = gui.get_node("item/bg")
	gui.set_enabled(itemNode, false)
	itemSize = gui.get_size(itemNode)
	invNode = gui.get_node("inventory/bg")
	invPos = gui.get_position(invNode)
	invSize = gui.get_size(invNode)
	shadowColor = gui.get_color(gui.get_node("item/shadow/bg"))
	framePos = gui.get_position(gui.get_node("item/frame/bg"))
	numRows = math.floor( invSize.y / itemSize.y )
	numCols = math.floor( invSize.x / itemSize.x )
	invPadding = ( invSize.x - ( itemSize.x * numCols ) ) / 2
end

--[[******************************************
				FUNCTIONS
********************************************]]

--[[ Gorvo the Fence, the patron for this screen (gdd/heroes-roster.md), stands
at the top and appraises every item: its normal price shows first, then his
stamp lands and the price counts up to his. ]]
local GORVO_SIZE = 180
local gorvo = nil

local function gorvo_factor()
	return actions.patron_value("HERO_GORVOTHEFENCE_NAME", 2, 20, 1)
end

local function show_gorvo()
	if gorvo_factor() <= 1 then
		if gorvo then gui.set_enabled(gorvo, false) end
		return
	end
	if not gorvo then
		gorvo = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(GORVO_SIZE, GORVO_SIZE, 0))
		gui.set_texture(gorvo, "main")
		gui.play_flipbook(gorvo, "patron_gorvothefence")
		gui.set_parent(gorvo, gui.get_node("root"))
	end
	gui.set_enabled(gorvo, true)
	local inv = gui.get_position(invNode)
	local top = vmath.vector3(inv.x + invSize.x - GORVO_SIZE / 2, inv.y + GORVO_SIZE / 2, 0)
	gui.set_position(gorvo, vmath.vector3(top.x + 300, top.y, 0))
	gui.animate(gorvo, "position", top, gui.EASING_OUTBACK, 0.5)
end

local function stamp_price(slot)
	local node = slot.nodes[hash("item/value")]
	gui.set_text(node, actions.display_number(slot.item.baseValue) .. " gold")
	local delay = 0.4 + slot.num * 0.08
	local scale = gui.get_scale(node)
	gui.animate(node, "scale", scale * 1.5, gui.EASING_OUTQUAD, 0.12, delay, function(self, n)
		gui.set_text(n, actions.display_number(slot.item.totalValue) .. " gold  " .. loc.get("HERO_BONUS_NOQUESTIONS", { actions.display_number(gorvo_factor()) }))
		gui.set_color(n, actions.get_color("green"))
		gui.animate(n, "scale", scale, gui.EASING_OUTBACK, 0.25)
	end)
end

local function update_item(slot)
	assert(slot.item, string.upper(currentPage) .. ": Item data missing")

	gui.set_text(slot.nodes[hash("item/text")], actions.display_number(slot.item.Count))
	gui.set_enabled(slot.nodes[hash("item/text")], slot.item.Count > 0)

	gui.set_text(slot.nodes[hash("item/value")], actions.display_number(slot.item.totalValue) .. " gold")
	gui.set_color(slot.nodes[hash("item/value")], actions.get_color("brightgold"))
	gui.set_enabled(slot.nodes[hash("item/value")], slot.item.totalValue > 0 and slot.item.Count > 0 )
	if slot.item.baseValue and slot.item.totalValue > 0 and slot.item.Count > 0 then stamp_price(slot) end


	if slot.item.totalValue > 0 and slot.item.Count > 0 then
		gui.play_flipbook(slot.nodes[hash("item/icon/bg")], "tinyfancypanel_gold")
		gui.play_flipbook(slot.nodes[hash("item/frame/bg")], "tinyfancypanel_gold")
	else
		gui.play_flipbook(slot.nodes[hash("item/icon/bg")], "tinyfancypanel_grey")
		gui.play_flipbook(slot.nodes[hash("item/frame/bg")], "tinyfancypanel_darkgrey")
	end

	if slot.item.Lifetime + slot.item.Count > 0 then

		gui.set_enabled(slot.nodes[hash("item/unknown")], false )
		gui.set_enabled(slot.nodes[hash("item/icon")], true )
		actions.set_item_icon(slot.nodes[hash("item/icon")], slot.item.Icon)


		gui.set_enabled(slot.nodes[hash("item/icon/shadow")], true )
		actions.set_item_icon(slot.nodes[hash("item/icon/shadow")], slot.item.Icon)
	else
		gui.set_enabled(slot.nodes[hash("item/unknown")], true )
		gui.set_enabled(slot.nodes[hash("item/icon")], false )
		gui.set_enabled(slot.nodes[hash("item/icon/shadow")], false )
	end
end

local function set_itempos(slot)
	local row = math.floor( slot.num / numCols )
	local col = slot.num - ( row * numCols )

	slot.item.pos = vmath.vector3( invPos.x + ( col * itemSize.x ) + invPadding, invPos.y - ( row * itemSize.y ) - invPadding, 1 )
	gui.set_position( slot.nodes[hash("item/bg")], slot.item.pos )


	local yPos = framePos.y + math.random(250, 750)
	local duration = math.random( 1, 4 ) / 5
	gui.set_position(slot.nodes[hash("item/frame/bg")], vmath.vector3(framePos.x, yPos, framePos.z))
	gui.animate(slot.nodes[hash("item/frame/bg")], "position.y", framePos.y, gui.EASING_OUTBOUNCE, duration)

	gui.set_color(slot.nodes[hash("item/shadow/bg")], vmath.vector4(shadowColor.x, shadowColor.y, shadowColor.z, 0))
	gui.animate(slot.nodes[hash("item/shadow/bg")], "color", vmath.vector4(shadowColor.x, shadowColor.y, shadowColor.z, 0.5), gui.EASING_OUTBOUNCE, duration)
	gui.set_scale(slot.nodes[hash("item/shadow/bg")], vmath.vector3(1,1,1))
	gui.animate(slot.nodes[hash("item/shadow/bg")], "scale", vmath.vector3(2, 2, 2), gui.EASING_OUTBOUNCE, duration)
	
	local rotation = math.random(-10, 10)
	gui.set_rotation(slot.nodes[hash("item/shadow/bg")], vmath.vector3(0,0,rotation - 6))
	gui.set_rotation(slot.nodes[hash("item/frame/bg")], vmath.vector3(0,0,rotation))

	return slot
end

local function delete_nodes(node_list)
	if node_list ~= nil then 
		for n,node in pairs(node_list) do
			gui.delete_node(node)
		end
		node_list = {}
	end
	return node_list
end

local function createSlot(slot, item)

	slot.nodes = delete_nodes(slot.nodes)
	slot.nodes = gui.clone_tree(itemNode)
	slot.item = item
	gui.set_enabled(slot.nodes[hash("item/bg")], true)
	return slot
end

local function update_inventory(data, nodes)
	local num = 0
	for i,item in pairs(data) do
		if item.Value > 0 then
			if gorvo_factor() > 1 and item.totalValue > 0 then
				item.baseValue = item.totalValue
				item.totalValue = math.floor(item.totalValue * gorvo_factor())
			end
			if inventory[i] == nil then inventory[i] = {} end
			inventory[i].num = num
			inventory[i] = createSlot(inventory[i], item)
			inventory[i] = set_itempos(inventory[i])
			update_item(inventory[i])
			invValue = invValue + item.totalValue
			num = num + 1
		end
	end
	return data, nodes
end

local function sort_cards(data, field1, field2, direction)
	direction = direction or true
	table.sort(data, function(a,b)
		assert(a[field1], "field " .. field1 .. " does not exist in " .. a.Name)
		assert(a[field2], "field " .. field2 .. " does not exist in " .. a.Name)
		assert(b[field1], "field " .. field1 .. " does not exist in " .. b.Name)
		assert(b[field2], "field " .. field2 .. " does not exist in " .. b.Name)
		if a[field1] < b[field1] then 
			return direction
		elseif a[field1] > b[field1] then 
			return not direction
		else
			return a[field2] < b[field2]
		end
	end)
	return data
end

--[[ The chapter's sell screen holds the main game's items. An event's items
are sold once, on the screen that follows the end of its run, from the haul
repController saved then (Stats.EventHaul), since the next run clears them. ]]
local function haul_items()
	local items = {}
	if haul then
		for id,kept in pairs(haul.items) do
			local item = actions.clone(defsave.loaded.Resources.data[id])
			item.Count, item.totalValue = kept.Count, kept.totalValue
			items[id] = item
		end
	else
		for id,resource in pairs(defsave.loaded.Resources.data) do
			if not (resource.Location and resource.Location.map_id ~= 1) then items[id] = actions.clone(resource) end
		end
	end
	return items
end

local function refresh_all()
	if enabled then

		Currency = actions.clone(defsave.loaded.Currency.data)
		gui.set_text(gui.get_node("gold/total"), Currency.Gold + bonusGold)
		gui.set_text(gui.get_node("xp/total"), Currency.Xp)
		gui.set_text(gui.get_node("followers/total"), actions.display_number(defsave.get("Currency","Followers")) )
		
		resource_data = haul_items()
		resource_data = sort_cards(resource_data, "Name", "totalValue", true)
		resource_data, resource_nodes = update_inventory(resource_data, resource_nodes)
		show_gorvo()
	end
end

--[[******************************************
					INPUT
********************************************]]

local function on_itembutton_pressed(num)

	local particlespeed = 1
	local iconNode = inventory[num].nodes[hash("item/frame/bg")]
	local startPos = gui.get_screen_position(iconNode)
	-- Gorvo's prices can run high, so each coin carries a share of the sale
	-- rather than one gold, and the screen does not fill with coins.
	local total = inventory[num].item.totalValue
	local numParticles = math.min(total, 40)
	local each = numParticles > 0 and math.floor(total / numParticles) or 0
	if total - each * numParticles > 0 then
		msg.post("main:/menu#sellitems", "mod_bonusGold", { amount = total - each * numParticles })
	end
	if gorvo then gui.animate(gorvo, "scale", vmath.vector3(1.08, 0.94, 1), gui.EASING_OUTQUAD, 0.1, 0, nil, gui.PLAYBACK_ONCE_PINGPONG) end


	local postmsg = { receiver = "main:/menu#sellitems", message_id = "mod_bonusGold", message = { amount = each } }
	msg.post(controller, "spawn_particles", { num = numParticles, startPos = startPos, endTarget = "target_gold", time = particlespeed, icon = { texture = "main", flipbook = "coin_spin" }, postmsg = postmsg } )

	invValue = invValue - inventory[num].item.totalValue
	inventory[num].item.totalValue = 0
	gui.set_text(inventory[num].nodes[hash("item/value")], "")

	gui.set_text(inventory[num].nodes[hash("item/text")], "0")
	gui.play_flipbook(inventory[num].nodes[hash("item/frame/bg")], "tinyfancypanel_darkbrown")
	gui.play_flipbook(inventory[num].nodes[hash("item/icon/bg")], "tinyfancypanel_brown")

end

local function update_button(button)
	if invValue > 0 then
		gui.play_flipbook(button.node, "tinyfancybutton_grey")
	else
		gui.play_flipbook(button.node, "tinyfancybutton_orange")
	end
end

local function on_button_pressed(button)
	if enabled and invValue <= 0 then
		for s,slot in pairs(inventory) do
			inventory[s].nodes = delete_nodes(inventory[s].nodes)
		end
		inventory = {}
		msg.post(controller, "mod_gold", { amount = bonusGold } )
		if haul then
			haul = nil
			defsave.set("Stats", "EventHaul", nil)
			defsave.save("Stats", true)
			msg.post(controller, "show_dungeonmine", { map_id = 1, dungeon_id = 1 })
			return
		end
		msg.post(controller, "chapter_gold", { amount = bonusGold, rank = defsave.get("Stats", "Rank") } )
		msg.post(controller, "complete_rank", { callback = "dungeonmine", rank = defsave.get("Stats", "Rank"), portal = portal })
		msg.post(controller, "show_dungeonmine", { map_id = 1, dungeon_id = 1 })
	end
end

function on_input(self, action_id, action)
	if action_id ~= nil and enabled and action.pressed then
		for n,node in pairs(inventory) do
			assert(inventory[n].nodes[hash("item/bg")], "node missing for " .. inventory[n].item.Name .. inspect(inventory[n]))
			local node = inventory[n].nodes[hash("item/bg")]
			local pos = gui.get_position(node)
			if gui.pick_node(node, action.x, action.y) and inventory[n].item.Count > 0 then
				on_itembutton_pressed(n)
			end
		end
	end
	gooey.button("button/bg", action_id, action, on_button_pressed, update_button)
end

--[[******************************************
					MESSAGES
********************************************]]

function on_message(self, message_id, message, sender)

	if message_id == hash("set_enabled") then
		enabled = message.enabled
		print(string.upper(currentPage), "enabled", enabled)
		gui.set_enabled(gui.get_node("root"), enabled)
		if enabled then
			msg.post(controller, "pause")
		else
			msg.post(controller, "unpause")
		end
		portal = message.portal or false
		haul = message.event_haul and defsave.get("Stats", "EventHaul") or nil
		if enabled then bonusGold, invValue = 0, 0 end
		refresh_all()

	elseif message_id == hash("refresh_all") then
		refresh_all()
	elseif message_id == hash("mod_bonusGold") then
		bonusGold = bonusGold + message.amount
		gui.set_text(gui.get_node("gold/total"), Currency.Gold + bonusGold)
	elseif message_id == hash("update_fps") then
		gui.set_text(gui.get_node("fps/text"), "fps: " .. message.text)
	end
end

function update()
	layout_screen()
end
