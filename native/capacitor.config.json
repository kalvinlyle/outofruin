{
  "appId": "games.misaligned.outofruin",
  "appName": "Out of Ruin",
  "webDir": "../game/dist",
  "android": {
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#1e2226"
  },
  "plugins": {
    "CapacitorUpdater": {
      "updateUrl": "https://app.outofruin.com/api/updates",
      "statsUrl": "https://app.outofruin.com/api/stats",
      "autoUpdate": true,
      "directUpdate": false,
      "resetWhenUpdate": true,
      "appReadyTimeout": 10000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "persistCustomId": true
    },
    "SystemBars": {
      "hidden": true,
      "insetsHandling": "disable"
    }
  }
}
